// A plugin's tab (docs/design/plugins.md, "Tabs and events"): widgets in a
// vertical form layout so each control gets the full dialog width. This
// ensures ComboBox options are never truncated — the user can always read
// the full string. Canvases and lists also take full width and stretch
// to fill available vertical room.

import { Button, CheckBox, Slider, LineEdit, ComboBox, StandardListView, Palette } from "std-widgets.slint";

// What the user does on a plugin's surface (interface 1.14), for whichever
// view shows it (`view`: the window's area number, 4 for a plugin's
// dialog): plugin_view.rs sends it to the plugin. `key` answers whether the key
// was the plugin's (a named key, or a character with Ctrl or Alt): what it
// doesn't take goes on to the surface's text sink, which hears typing, an
// input method and pasting as text (`typed`). `copy` is how a plugin's
// text reaches the clipboard: through the one TextInput the window keeps
// for it (app.slint's `clipboard`).
export global PluginSurfaces {
    callback room(int, string, float, float);
    // Down (0), up (1), a drag (2), a move with no button (3), left (4);
    // where, in logical pixels; which button (0 main, 1 right, 2 middle).
    callback pointer(int, string, int, float, float, int);
    callback wheel(int, string, float, float, float, float);
    // The key's text (Slint's KeyEvent text), Shift, Ctrl, Alt.
    callback key(int, string, string, bool, bool, bool) -> bool;
    callback typed(int, string, string);
    callback focus(int, string, bool);
}

// A plugin's link was clicked (interface 1.4): main.rs opens its address
// in the browser, `https://` only (links.rs), for whichever window shows it.
export global PluginLinks {
    callback open(string);
}

export struct PluginWidget {
    // label, button, toggle, slider, field, choice, list, canvas or link.
    kind: string,
    id: string,
    text: string,
    // Labels: dimmer, for secondary text. Fields: the placeholder is `text2`.
    // Links: the address is `text2`.
    muted: bool,
    text2: string,
    on: bool,
    enabled: bool,
    value: float,
    minimum: float,
    maximum: float,
    options: [string],
    items: [StandardListViewItem],
    selected: int,
    // Choices: wide enough for their longest option (its text's length,
    // estimated in plugin_view.rs), so the list doesn't cut options short.
    wide: length,
    // Canvases: the drawing, and the canvas's size in its own units.
    canvas: image,
    canvas-width: float,
    canvas-height: float,
    // Surfaces (interface 1.14): the height asked for (0 fills the room),
    // whether it takes the keyboard, and the pointer's shape (0 default,
    // 1 pointer, 2 text, 3 grab, 4 grabbing, 5 not allowed, 6 wait).
    surface-height: float,
    keys: bool,
    cursor: int,
}

export struct PluginRow {
    widgets: [PluginWidget],
    // A row holding a canvas or a list takes the room left.
    stretch: bool,
}

// A single widget in a vertical form layout. The label (if any) sits above
// the control, and the control fills the full dialog width via
// horizontal-stretch.
export component PluginWidgetView {
    in property <PluginWidget> w;
    // The view showing it, for surfaces' events (PluginSurfaces).
    in property <int> view;
    callback clicked(string);
    callback toggled(string, bool);
    callback slid(string, float);
    callback edited(string, string);
    callback chosen(string, int);
    callback pointer(string, int, float, float, int);
    callback canvas-room(string, length, length);

    VerticalLayout {
        spacing: 4px;
        padding-right: 12px;
        padding-left: 12px;
        padding-bottom: 4px;

        // Label row: shown for buttons, toggles, sliders, and fields. A
        // long one wraps at the width it has, rather than widening the
        // form (the export dialog's options, #313).
        if w.kind == "label" || w.kind == "button" || w.kind == "toggle"
        || w.kind == "slider" || w.kind == "field" : Text {
            text: w.text;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
            color: Palette.foreground.transparentize(w.muted ? 0.45 : 0.1);
        }
        // Link row: just the link text (no label above).
        if w.kind == "link" : Text {
            text: w.text;
            font-size: 12px;
            vertical-alignment: center;
            color: Palette.accent-background;
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { PluginLinks.open(w.text2); }
            }
        }
        // Control row: each control fills the full width.
        if w.kind == "button" : Button {
            horizontal-stretch: 1;
            text: w.text;
            enabled: w.enabled;
            clicked => { root.clicked(w.id); }
        }
        if w.kind == "toggle" : CheckBox {
            horizontal-stretch: 1;
            text: w.text;
            checked: w.on;
            enabled: w.enabled;
            // The plugin's answer wins over the user's click (the click
            // breaks the binding above): the window changes rows in place.
            property <bool> says: w.on;
            changed says => { self.checked = self.says; }
            toggled => { root.toggled(w.id, self.checked); }
        }
        if w.kind == "slider" : Slider {
            horizontal-stretch: 1;
            minimum: w.minimum;
            maximum: w.maximum;
            value: w.value;
            enabled: w.enabled;
            property <float> says: w.value;
            changed says => { self.value = self.says; }
            released(v) => { root.slid(w.id, v); }
        }
        if w.kind == "field" : LineEdit {
            horizontal-stretch: 1;
            text: w.text;
            placeholder-text: w.text2;
            enabled: w.enabled;
            property <string> says: w.text;
            changed says => { self.text = self.says; }
            accepted(t) => { root.edited(w.id, t); }
            // Entered also when the keyboard leaves it (clicking OK, say),
            // as the Song tab's fields are, so nothing typed is lost.
            changed has-focus => {
                if (!self.has-focus && self.text != w.text) {
                    root.edited(w.id, self.text);
                }
            }
        }
        if w.kind == "choice" : ComboBox {
            horizontal-stretch: 1;
            model: w.options;
            current-index: w.selected;
            enabled: w.enabled;
            property <int> says: w.selected;
            changed says => { self.current-index = self.says; }
            selected => { root.chosen(w.id, self.current-index); }
        }
        if w.kind == "list" : StandardListView {
            horizontal-stretch: 1;
            min-height: 84px;
            model: w.items;
            current-item: w.selected;
            property <int> says: w.selected;
            changed says => { self.current-item = self.says; }
            current-item-changed(i) => { root.chosen(w.id, i); }
        }
        if w.kind == "surface" : surface := Rectangle {
            horizontal-stretch: 1;
            min-height: w.surface-height > 0 ? w.surface-height * 1px : 24px;
            preferred-height: w.surface-height > 0 ? w.surface-height * 1px : 2000px;
            vertical-stretch: w.surface-height > 0 ? 0 : 1;
            clip: true;
            property <int> button;
            init => { PluginSurfaces.room(root.view, w.id, self.width / 1px, self.height / 1px); }
            changed width => { PluginSurfaces.room(root.view, w.id, self.width / 1px, self.height / 1px); }
            changed height => { PluginSurfaces.room(root.view, w.id, self.width / 1px, self.height / 1px); }
            // Drawn at the device pixels it covers: shown one to one.
            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                source: w.canvas;
                image-fit: fill;
            }
            area := TouchArea {
                mouse-cursor: w.cursor == 1 ? MouseCursor.pointer
                    : w.cursor == 2 ? MouseCursor.text
                    : w.cursor == 3 ? MouseCursor.grab
                    : w.cursor == 4 ? MouseCursor.grabbing
                    : w.cursor == 5 ? MouseCursor.not-allowed
                    : w.cursor == 6 ? MouseCursor.wait
                    : MouseCursor.default;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        surface.button = e.button == PointerEventButton.right ? 1
                            : e.button == PointerEventButton.middle ? 2 : 0;
                        if (w.keys) {
                            sink.focus();
                        }
                        PluginSurfaces.pointer(root.view, w.id, 0, self.mouse-x / 1px, self.mouse-y / 1px, surface.button);
                    } else if (e.kind == PointerEventKind.up) {
                        PluginSurfaces.pointer(root.view, w.id, 1, self.mouse-x / 1px, self.mouse-y / 1px, surface.button);
                    } else if (e.kind == PointerEventKind.move) {
                        PluginSurfaces.pointer(root.view, w.id, self.pressed ? 2 : 3, self.mouse-x / 1px, self.mouse-y / 1px,
                            self.pressed ? surface.button : 0);
                    }
                }
                changed has-hover => {
                    if (!self.has-hover) {
                        PluginSurfaces.pointer(root.view, w.id, 4, self.mouse-x / 1px, self.mouse-y / 1px, 0);
                    }
                }
                scroll-event(e) => {
                    // Slint's delta is how far the contents move: down the
                    // wheel, up they go, which the plugin hears as positive.
                    PluginSurfaces.wheel(root.view, w.id, self.mouse-x / 1px, self.mouse-y / 1px, -e.delta-x / 1px, -e.delta-y / 1px);
                    accept
                }
            }
            // The keyboard, once clicked: keys that aren't text are the
            // plugin's; text (typed, from an input method, pasted) comes
            // through the invisible sink.
            FocusScope {
                x: 0;
                y: 0;
                width: 1px;
                height: 1px;
                enabled: w.keys;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                capture-key-pressed(e) => {
                    if (PluginSurfaces.key(root.view, w.id, e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt)) {
                        return accept;
                    }
                    reject
                }
                sink := TextInput {
                    width: 1px;
                    height: 1px;
                    opacity: 0;
                    single-line: false;
                    enabled: w.keys;
                    edited => {
                        if (self.text != "") {
                            PluginSurfaces.typed(root.view, w.id, self.text);
                            self.text = "";
                        }
                    }
                    changed has-focus => { PluginSurfaces.focus(root.view, w.id, self.has-focus); }
                }
            }
        }
        if w.kind == "canvas" : room := Rectangle {
            horizontal-stretch: 1;
            min-height: 24px;
            // Canvas units to logical pixels, keeping the proportions.
            property <float> scale: min(self.width / 1px / w.canvas-width, self.height / 1px / w.canvas-height);
            property <int> button;
            init => { root.canvas-room(w.id, self.width, self.height); }
            changed width => { root.canvas-room(w.id, self.width, self.height); }
            changed height => { root.canvas-room(w.id, self.width, self.height); }
            drawing := Image {
                width: w.canvas-width * room.scale * 1px;
                height: w.canvas-height * room.scale * 1px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: w.canvas;
                image-fit: fill;
            }
            TouchArea {
                x: drawing.x;
                y: drawing.y;
                width: drawing.width;
                height: drawing.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.up) {
                        if (e.kind == PointerEventKind.down) {
                            room.button = e.button == PointerEventButton.right ? 1
                                : e.button == PointerEventButton.middle ? 2 : 0;
                        }
                        root.pointer(w.id, e.kind == PointerEventKind.down ? 0 : 1,
                            self.mouse-x / 1px / room.scale, self.mouse-y / 1px / room.scale, room.button);
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.pointer(w.id, 2, self.mouse-x / 1px / room.scale, self.mouse-y / 1px / room.scale, room.button);
                    }
                }
            }
        }
    }
}

// A plugin's section of the track dialog (interface 1.3): its heading, and
// its rows or a message instead (while the plugin is asked, or why it
// can't be shown). A section of a plugin with effects for the track can
// move up or down, which changes the order the effects run in (#152).
export struct PluginSection {
    title: string,
    rows: [PluginRow],
    message: string,
    up: bool,
    down: bool,
}

// A plugin's rows in a vertical form layout: each widget gets the full
// dialog width so ComboBox options are never truncated.
export component PluginRows inherits VerticalLayout {
    in property <[PluginRow]> rows;
    // Shown instead of the rows: while the plugin is asked, or why they
    // can't be shown.
    in property <string> message;
    callback clicked(string);
    callback toggled(string, bool);
    callback slid(string, float);
    callback edited(string, string);
    callback chosen(string, int);
    spacing: 2px;
    if root.message != "" : Text {
        text: root.message;
        font-size: 12px;
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.4);
    }
    if root.message == "" : VerticalLayout {
        spacing: 2px;
        for row in root.rows : VerticalLayout {
            spacing: 2px;
            for w in row.widgets : PluginWidgetView {
                w: w;
                clicked(id) => { root.clicked(id); }
                toggled(id, on) => { root.toggled(id, on); }
                slid(id, v) => { root.slid(id, v); }
                edited(id, t) => { root.edited(id, t); }
                chosen(id, i) => { root.chosen(id, i); }
            }
        }
    }
}

export component PluginTab inherits Rectangle {
    in property <[PluginRow]> rows;
    // The view it is (the window's area number, 4 for a plugin's dialog),
    // for surfaces' events.
    in property <int> view;
    // Shown instead of the rows: while the plugin is asked, or why its tab
    // can't be shown.
    in property <string> message;
    callback clicked(string);
    callback toggled(string, bool);
    callback slid(string, float);
    callback edited(string, string);
    callback chosen(string, int);
    // The pointer on a canvas: down (0), up (1) or a drag (2), where in the
    // canvas's units, and which button (0 main, 1 right, 2 middle).
    callback pointer(string, int, float, float, int);
    // A canvas's room, in logical pixels.
    callback canvas-room(string, length, length);

    if root.message != "" : Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.message;
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: center;
        color: Palette.foreground.transparentize(0.4);
    }
    if root.message == "" : VerticalLayout {
        padding: 6px;
        spacing: 6px;
        for row in root.rows : VerticalLayout {
            spacing: 2px;
            for w in row.widgets : PluginWidgetView {
                w: w;
                view: root.view;
                clicked(id) => { root.clicked(id); }
                toggled(id, on) => { root.toggled(id, on); }
                slid(id, v) => { root.slid(id, v); }
                edited(id, t) => { root.edited(id, t); }
                chosen(id, i) => { root.chosen(id, i); }
                pointer(id, k, x, y, b) => { root.pointer(id, k, x, y, b); }
                canvas-room(id, wd, ht) => { root.canvas-room(id, wd, ht); }
            }
        }
    }
}
