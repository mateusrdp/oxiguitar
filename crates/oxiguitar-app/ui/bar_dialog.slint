// The dialogs over the window (Custom N-tuplet, Transpose,
// the bend editor, the chord dialog and the rest), like the Question:
// nothing behind them takes clicks or keys. The Bar dialog is gone: its
// fields are the Bar tab's (issue #177, `bar_form.rs`).

import { Button, CheckBox, ComboBox, LineEdit, SpinBox, ScrollView, Palette } from "std-widgets.slint";

// A dimmed backdrop and a card, with Enter for OK and Escape for Cancel.
component Card inherits Rectangle {
    in property <length> card-width: 560px;
    // Whether the card takes the keyboard (Enter, Escape) when it opens;
    // a card whose field takes it instead says no.
    in property <bool> takes-focus: true;
    in property <string> heading;
    in property <string> ok-text: "OK";
    callback done(bool);
    background: #00000060;
    TouchArea { }
    keys := FocusScope {
        init => {
            if (root.takes-focus) {
                self.focus();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.done(false);
                return accept;
            }
            if (event.text == Key.Return) {
                root.done(true);
                return accept;
            }
            accept
        }
    }
    Rectangle {
        width: min(root.card-width, root.width - 40px);
        height: min(box.preferred-height, root.height - 40px);
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        box := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: root.heading; font-size: 15px; font-weight: 700; }
            ScrollView {
                preferred-height: min(content.preferred-height, root.height - 160px);
                content := VerticalLayout {
                    padding-right: 12px;
                    @children
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: root.ok-text; primary: true; clicked => { root.done(true); } }
                Button { text: "Cancel"; clicked => { root.done(false); } }
            }
        }
    }
}

// A label in the dialog's first column.
component Label inherits Text {
    font-size: 12px;
    vertical-alignment: center;
    min-width: 120px;
}

export component TupletDialog inherits Rectangle {
    // Nested N-tuplet: the tuplet goes inside the one the beats have.
    in property <bool> nested: false;
    in-out property <int> notes: 3;
    in-out property <int> in-time-of: 2;
    // The usual "in the time of" for a number of notes (`bar_form.rs`).
    pure callback usual(int) -> int;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.nested ? "Nested N-tuplet" : "Custom N-tuplet";
        card-width: 360px;
        done(ok) => { root.done(ok); }
        HorizontalLayout {
            spacing: 8px;
            SpinBox {
                minimum: 2;
                maximum: 32;
                value: root.notes;
                edited(v) => {
                    root.notes = v;
                    root.in-time-of = root.usual(v);
                }
            }
            Text { text: "notes in the time of"; vertical-alignment: center; font-size: 12px; }
            SpinBox {
                minimum: 1;
                maximum: 32;
                value: root.in-time-of;
                edited(v) => { root.in-time-of = v; }
            }
        }
    }
}

export component PasteDialog inherits Rectangle {
    in-out property <int> times: 1;
    in-out property <bool> replace: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: "Special Paste";
        card-width: 380px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Paste"; vertical-alignment: center; font-size: 12px; }
                SpinBox {
                    minimum: 1;
                    maximum: 99;
                    value: root.times;
                    edited(v) => { root.times = v; }
                }
                Text { text: "times"; vertical-alignment: center; font-size: 12px; }
            }
            CheckBox {
                text: "Replace what is there, instead of inserting";
                checked: root.replace;
                toggled => { root.replace = self.checked; }
            }
        }
    }
}

// Transpose… (slice 5): by semitones or by steps of the key, keeping the
// fingering or finding new frets. The heading names what it applies to.
export component TransposeDialog inherits Rectangle {
    in property <string> heading: "Transpose";
    in-out property <int> amount: 0;
    in-out property <bool> steps: false;
    in-out property <bool> keep-fingering: true;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 440px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "By"; vertical-alignment: center; font-size: 12px; }
                SpinBox {
                    minimum: -24;
                    maximum: 24;
                    value: root.amount;
                    edited(v) => { root.amount = v; }
                }
                ComboBox {
                    horizontal-stretch: 1;
                    model: ["semitones", "steps of the key"];
                    current-index: root.steps ? 1 : 0;
                    selected => { root.steps = self.current-index == 1; }
                }
            }
            Text {
                text: "Up is positive, down negative. Steps of the key keep the music in its key.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
            CheckBox {
                text: "Keep the fingering (else find new frets)";
                checked: root.keep-fingering;
                toggled => { root.keep-fingering = self.checked; }
            }
        }
    }
}

// Fit Bars to Time Signature… (#222): re-bar the music across the bar
// lines, or stretch each bar to fill its time signature. The heading
// names what it applies to.
export component FitDialog inherits Rectangle {
    in property <string> heading: "Fit Bars to Time Signature";
    in-out property <bool> stretch: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 460px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            ComboBox {
                model: ["Re-bar: notes keep their lengths", "Stretch: each bar keeps its notes"];
                current-index: root.stretch ? 1 : 0;
                selected => { root.stretch = self.current-index == 1; }
            }
            Text {
                text: root.stretch
                    ? "Each bar that doesn't add up keeps its notes, scaled to fill its time signature, with tuplets where needed. The bars stay where they are."
                    : "The music flows across the bar lines: notes that cross one are tied, and bars are added or removed in every track. Repeats, endings and sections keep their bar lines.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
            Text {
                text: "Only bars that don't add up change, in every track.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// A point of a bend curve on the editor's grid (`bend_form::Point`).
export struct GridPoint {
    col: int,
    row: int,
}

// The bend and whammy-bar editor (M3 slice 6; `bend_form.rs`): a type, a
// pitch, and a curve whose points are dragged on a grid of twelfths of the
// note by quarter tones.
export component BendDialog inherits Rectangle {
    in property <string> heading: "Bend";
    in property <[string]> types;
    in property <[string]> amounts;
    in-out property <int> kind;
    in-out property <int> amount;
    // The lowest and highest rows (quarter tones).
    in property <int> low: 0;
    in property <int> high: 12;
    in property <[GridPoint]> points;
    // The curve as SVG path data, 10 units a cell.
    in property <string> path;
    callback kind-picked(int);
    callback amount-picked(int);
    callback pressed(float, float);
    callback dragged(float, float);
    callback released();
    callback done(bool);
    property <length> grid-w: 360px;
    property <length> grid-h: 240px;
    property <length> cell-w: self.grid-w / 12;
    property <length> cell-h: self.grid-h / (self.high - self.low);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 460px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.types;
                    current-index <=> root.kind;
                    selected => { root.kind-picked(self.current-index); }
                }
                ComboBox {
                    model: root.amounts;
                    current-index <=> root.amount;
                    selected => { root.amount-picked(self.current-index); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                // Whole tones up the side.
                Rectangle {
                    width: 34px;
                    height: root.grid-h;
                    for i in (root.high - root.low) / 4 + 1 : Text {
                        property <int> tones: (root.high - i * 4) / 4;
                        x: 0;
                        y: i * 4 * root.cell-h - 7px;
                        width: 30px;
                        horizontal-alignment: right;
                        font-size: 11px;
                        color: Palette.foreground;
                        opacity: 0.7;
                        text: self.tones == 0 ? "0" : self.tones < 0 ? "−" + (-self.tones) : self.tones;
                    }
                }
                Rectangle {
                    width: root.grid-w;
                    height: root.grid-h;
                    background: Palette.alternate-background;
                    border-color: Palette.border;
                    border-width: 1px;
                    for i in 13 : Rectangle {
                        x: i * root.cell-w;
                        y: 0;
                        width: 1px;
                        height: root.grid-h;
                        background: Palette.border;
                        opacity: mod(i, 3) == 0 ? 0.9 : 0.4;
                    }
                    for i in root.high - root.low + 1 : Rectangle {
                        x: 0;
                        y: i * root.cell-h;
                        width: root.grid-w;
                        height: root.high - i == 0 ? 2px : 1px;
                        background: Palette.border;
                        opacity: mod(root.high - i, 4) == 0 ? 0.9 : 0.35;
                    }
                    Path {
                        x: 0;
                        y: 0;
                        width: root.grid-w;
                        height: root.grid-h;
                        commands: root.path;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 120;
                        viewbox-height: (root.high - root.low) * 10;
                        fit: fill;
                        stroke: #2e9d5b;
                        stroke-width: 2px;
                    }
                    for p in root.points : Rectangle {
                        x: p.col * root.cell-w - 5px;
                        y: (root.high - p.row) * root.cell-h - 5px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: #2e9d5b;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.pressed(self.mouse-x / root.cell-w, root.high - self.mouse-y / root.cell-h);
                            }
                            if (e.kind == PointerEventKind.up) {
                                root.released();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.dragged(self.mouse-x / root.cell-w, root.high - self.mouse-y / root.cell-h);
                            }
                        }
                    }
                }
            }
            Text {
                text: "Drag the points: time across the note, pitch up the side in quarter tones. Enter applies; Escape cancels.";
                font-size: 11px;
                wrap: word-wrap;
                opacity: 0.7;
            }
        }
    }
}

// Text above a beat (M3 slice 6): one line; empty for none.
export component TextDialog inherits Rectangle {
    in-out property <string> text;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: "Text";
        card-width: 400px;
        takes-focus: false;
        done(ok) => { root.done(ok); }
        // Escape cancels from the field too.
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.done(false);
                    return accept;
                }
                reject
            }
            LineEdit {
                text <=> root.text;
                placeholder-text: "Text above the beat";
                init => { self.focus(); }
                accepted => { root.done(true); }
            }
        }
    }
}

// An alteration's tickbox in the chord dialog.
export struct AltBox {
    label: string,
    on: bool,
}

// The chord dialog (M3 slice 6; `chord_form.rs`): Guitar Pro 8's Chord
// window, with its builder.
export component ChordDialog inherits Rectangle {
    in-out property <string> name;
    in property <[string]> library;
    in property <[string]> roots;
    in-out property <int> root-index;
    in property <[string]> triads;
    in-out property <int> triad-index;
    in property <[string]> extensions;
    in-out property <int> extension-index;
    in property <[string]> basses;
    in-out property <int> bass-index;
    in property <[AltBox]> alterations;
    // Strings, and each string's dot, low to high: the row (0 the first
    // fret shown), -1 open, -2 not played, -3 off the grid.
    in property <int> strings: 6;
    in property <[int]> dots;
    in-out property <int> first-fret: 1;
    in property <int> last-fret: 24;
    in property <[string]> voicings;
    in property <bool> show-diagram: true;
    callback name-typed(string);
    callback library-picked(int);
    callback root-picked(int);
    callback triad-picked(int);
    callback extension-picked(int);
    callback bass-picked(int);
    callback alteration-toggled(int, bool);
    callback grid-clicked(int, int);
    callback head-clicked(int);
    callback scrolled(int);
    callback voicing-picked(int);
    callback show-toggled(bool);
    callback remove();
    callback done(bool);
    property <length> cell-w: 28px;
    property <length> cell-h: 30px;
    property <length> grid-w: (root.strings - 1) * root.cell-w;
    Card {
        width: root.width;
        height: root.height;
        heading: "Chord";
        card-width: 720px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Name"; font-size: 12px; vertical-alignment: center; }
                LineEdit {
                    text <=> root.name;
                    edited(t) => { root.name-typed(t); }
                    accepted => { root.done(true); }
                }
                if root.library.length > 0 : ComboBox {
                    min-width: 150px;
                    model: root.library;
                    current-index: -1;
                    current-value: "The track's chords";
                    selected => { root.library-picked(self.current-index); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                ComboBox { model: root.roots; current-index <=> root.root-index; selected => { root.root-picked(self.current-index); } }
                ComboBox { model: root.triads; current-index <=> root.triad-index; selected => { root.triad-picked(self.current-index); } }
                ComboBox { model: root.extensions; current-index <=> root.extension-index; selected => { root.extension-picked(self.current-index); } }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Bass"; font-size: 12px; vertical-alignment: center; }
                    ComboBox { model: root.basses; current-index <=> root.bass-index; selected => { root.bass-picked(self.current-index); } }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                for a[i] in root.alterations : CheckBox {
                    text: a.label;
                    checked: a.on;
                    toggled => { root.alteration-toggled(i, self.checked); }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                alignment: start;
                if root.strings > 1 : VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 6px;
                        CheckBox {
                            text: "Show the diagram";
                            checked: root.show-diagram;
                            toggled => { root.show-toggled(self.checked); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "First fret"; font-size: 12px; vertical-alignment: center; }
                        SpinBox {
                            width: 80px;
                            minimum: 1;
                            maximum: root.last-fret;
                            value <=> root.first-fret;
                            edited(v) => { root.scrolled(v); }
                        }
                    }
                    Rectangle {
                        width: root.grid-w + 2 * root.cell-w;
                        height: 5 * root.cell-h + 26px;
                        opacity: root.show-diagram ? 1 : 0.4;
                        // Open and not-played marks above the strings.
                        for d[i] in root.dots : Rectangle {
                            x: root.cell-w + i * root.cell-w - 10px;
                            y: 0;
                            width: 20px;
                            height: 20px;
                            Text {
                                text: d == -1 ? "o" : d == -2 ? "×" : "";
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.head-clicked(i); } }
                        }
                        Rectangle {
                            x: root.cell-w;
                            y: 24px;
                            width: root.grid-w;
                            height: 5 * root.cell-h;
                            // The nut, or the first fret's number.
                            Rectangle {
                                y: 0;
                                height: root.first-fret == 1 ? 4px : 1px;
                                background: Palette.foreground;
                            }
                            if root.first-fret > 1 : Text {
                                x: -root.cell-w;
                                y: root.cell-h / 2 - 8px;
                                width: root.cell-w - 4px;
                                horizontal-alignment: right;
                                text: root.first-fret;
                                font-size: 11px;
                            }
                            for i in 6 : Rectangle {
                                y: i * root.cell-h;
                                height: 1px;
                                background: Palette.foreground;
                                opacity: 0.6;
                            }
                            for i in root.strings : Rectangle {
                                x: i * root.cell-w;
                                width: 1px;
                                background: Palette.foreground;
                                opacity: 0.6;
                            }
                            for d[i] in root.dots : Rectangle {
                                visible: d >= 0;
                                x: i * root.cell-w - 9px;
                                y: max(d, 0) * root.cell-h + root.cell-h / 2 - 9px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: Palette.foreground;
                            }
                            TouchArea {
                                x: -root.cell-w / 2;
                                width: root.grid-w + root.cell-w;
                                clicked => {
                                    root.grid-clicked(
                                        clamp(round((self.mouse-x - root.cell-w / 2) / root.cell-w), 0, root.strings - 1),
                                        clamp(floor(self.mouse-y / root.cell-h), 0, 4));
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    if root.voicings.length > 0 : Text { text: "Ways to play it, low string first"; font-size: 12px; }
                    for v[i] in root.voicings : Rectangle {
                        height: 24px;
                        width: 170px;
                        border-radius: 4px;
                        background: touch.has-hover ? Palette.control-background : transparent;
                        Text {
                            x: 6px;
                            text: v;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        touch := TouchArea { clicked => { root.voicing-picked(i); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                Button { text: "Remove the chord"; clicked => { root.remove(); } }
            }
        }
    }
}

// File → Export of an audio exporter (M4 slice 7, PLAY-7): what to render
// before the file dialog. The whole song or the selected bars, at the
// written tempo or the practice speed, with or without the metronome.
export component ExportDialog inherits Rectangle {
    in property <string> heading: "Export Audio";
    // Where the file's format is set: the exporter's plugin's settings.
    in property <string> plugin-name;
    in property <bool> has-selection: false;
    in-out property <bool> selection: false;
    in property <int> practice-speed: 100;
    in-out property <bool> at-speed: false;
    in-out property <bool> metronome: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        ok-text: "Export…";
        card-width: 440px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Label { text: "What"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.has-selection ? ["The whole song", "The selected bars"] : ["The whole song"];
                    current-index: root.selection && root.has-selection ? 1 : 0;
                    selected => { root.selection = self.current-index == 1; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Tempo"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.practice-speed == 100
                        ? ["As written"]
                        : ["As written", "At the practice speed (" + root.practice-speed + " %)"];
                    current-index: root.at-speed && root.practice-speed != 100 ? 1 : 0;
                    selected => { root.at-speed = self.current-index == 1; }
                }
            }
            CheckBox {
                text: "The metronome's clicks in the sound";
                checked: root.metronome;
                toggled => { root.metronome = self.checked; }
            }
            Text {
                text: "Each track plays with its sound, amp and mixer settings as they are now. The file's format (bit depth, rate) is set in the settings of the plugin “" + root.plugin-name + "” (Tools → Plugins…, its Settings… button).";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// An audio export under way: how far it has got, and Cancel. Over the
// window, so nothing changes the score while it renders.
export component ExportProgress inherits Rectangle {
    in property <string> status;
    in property <float> progress;
    callback cancel();
    background: #00000060;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
            }
            accept
        }
    }
    Rectangle {
        width: min(400px, root.width - 40px);
        height: box.preferred-height;
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        box := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: root.status; font-size: 13px; wrap: word-wrap; }
            Rectangle {
                height: 8px;
                border-radius: 4px;
                background: Palette.alternate-background;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    border-radius: 4px;
                    background: Palette.accent-background;
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

// Display Options… (bar colours): pick a bar colour or track bar colour.
export component DisplayOptionsDialog inherits Rectangle {
    in-out property <bool> bar-colour-set: false;
    in-out property <int> bar-colour-r: 128;
    in-out property <int> bar-colour-g: 128;
    in-out property <int> bar-colour-b: 128;
    in-out property <bool> track-bar-colour-set: false;
    in-out property <int> track-bar-colour-r: 128;
    in-out property <int> track-bar-colour-g: 128;
    in-out property <int> track-bar-colour-b: 128;
    callback done(bool, bool, int, int, int, bool, int, int, int);
    Card {
        width: root.width;
        height: root.height;
        heading: "Display Options";
        card-width: 420px;
        done(ok) => {
            root.done(ok,
                root.bar-colour-set, root.bar-colour-r, root.bar-colour-g, root.bar-colour-b,
                root.track-bar-colour-set, root.track-bar-colour-r, root.track-bar-colour-g, root.track-bar-colour-b);
        }
        VerticalLayout {
            spacing: 8px;
            // Bar Colour (global)
            Label { text: "Bar Colour"; }
            HorizontalLayout {
                spacing: 8px;
                CheckBox {
                    text: "Enable";
                    checked: root.bar-colour-set;
                    toggled => { root.bar-colour-set = self.checked; }
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 3px;
                    background: rgb(root.bar-colour-set ? root.bar-colour-r : 128,
                                    root.bar-colour-set ? root.bar-colour-g : 128,
                                    root.bar-colour-set ? root.bar-colour-b : 128);
                }
                Text { text: "R"; font-size: 11px; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 255; value: root.bar-colour-set ? root.bar-colour-r : 128; enabled: root.bar-colour-set; edited(v) => { root.bar-colour-r = v; } }
                Text { text: "G"; font-size: 11px; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 255; value: root.bar-colour-set ? root.bar-colour-g : 128; enabled: root.bar-colour-set; edited(v) => { root.bar-colour-g = v; } }
                Text { text: "B"; font-size: 11px; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 255; value: root.bar-colour-set ? root.bar-colour-b : 128; enabled: root.bar-colour-set; edited(v) => { root.bar-colour-b = v; } }
            }
            // Track Bar Colour (per-track)
            Label { text: "Track Bar Colour"; }
            HorizontalLayout {
                spacing: 8px;
                CheckBox {
                    text: "Enable";
                    checked: root.track-bar-colour-set;
                    toggled => { root.track-bar-colour-set = self.checked; }
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 3px;
                    background: rgb(root.track-bar-colour-set ? root.track-bar-colour-r : 128,
                                    root.track-bar-colour-set ? root.track-bar-colour-g : 128,
                                    root.track-bar-colour-set ? root.track-bar-colour-b : 128);
                }
                Text { text: "R"; font-size: 11px; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 255; value: root.track-bar-colour-set ? root.track-bar-colour-r : 128; enabled: root.track-bar-colour-set; edited(v) => { root.track-bar-colour-r = v; } }
                Text { text: "G"; font-size: 11px; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 255; value: root.track-bar-colour-set ? root.track-bar-colour-g : 128; enabled: root.track-bar-colour-set; edited(v) => { root.track-bar-colour-g = v; } }
                Text { text: "B"; font-size: 11px; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 255; value: root.track-bar-colour-set ? root.track-bar-colour-b : 128; enabled: root.track-bar-colour-set; edited(v) => { root.track-bar-colour-b = v; } }
            }
            Text {
                text: "Section colour is set via the Bar tab's section marker. Colours cascade: Track Bar > Bar > Section > System.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}
