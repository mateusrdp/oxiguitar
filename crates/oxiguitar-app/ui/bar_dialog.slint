// The dialogs over the window (Custom N-tuplet, Transpose,
// the bend editor, the chord dialog and the rest), like the Question:
// nothing behind them takes clicks or keys. The Bar dialog is gone: its
// fields are the Bar tab's (issue #177, `bar_form.rs`).

import { Button, CheckBox, ComboBox, LineEdit, SpinBox, ScrollView, Palette } from "std-widgets.slint";
import { PluginTab, PluginRow } from "plugin_tab.slint";

// A dimmed backdrop and a card, with Enter for OK and Escape for Cancel.
component Card inherits Rectangle {
    in property <length> card-width: 560px;
    // Whether the card takes the keyboard (Enter, Escape) when it opens;
    // a card whose field takes it instead says no.
    in property <bool> takes-focus: true;
    in property <string> heading;
    in property <string> ok-text: "OK";
    in property <bool> ok-enabled: true;
    in property <bool> show-buttons: true;
    callback done(bool);
    background: #00000060;
    TouchArea { }
    keys := FocusScope {
        init => {
            if (root.takes-focus) {
                self.focus();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.done(false);
                return accept;
            }
            if (event.text == Key.Return && root.show-buttons && root.ok-enabled) {
                root.done(true);
                return accept;
            }
            accept
        }
    }
    Rectangle {
        width: min(root.card-width, root.width - 40px);
        height: min(box.preferred-height, root.height - 40px);
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        box := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: root.heading; font-size: 15px; font-weight: 700; }
            ScrollView {
                preferred-height: min(content.preferred-height, root.height - 160px);
                content := VerticalLayout {
                    padding-right: 12px;
                    @children
                }
            }
            if (root.show-buttons): HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: root.ok-text; primary: true; enabled: root.ok-enabled; clicked => { root.done(true); } }
                Button { text: "Cancel"; clicked => { root.done(false); } }
            }
        }
    }
}

// A label in the dialog's first column.
component Label inherits Text {
    font-size: 12px;
    vertical-alignment: center;
    min-width: 120px;
}

export component TupletDialog inherits Rectangle {
    // Nested N-tuplet: the tuplet goes inside the one the beats have.
    in property <bool> nested: false;
    in-out property <int> notes: 3;
    in-out property <int> in-time-of: 2;
    // The usual "in the time of" for a number of notes (`bar_form.rs`).
    pure callback usual(int) -> int;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.nested ? "Nested N-tuplet" : "Custom N-tuplet";
        card-width: 360px;
        done(ok) => { root.done(ok); }
        HorizontalLayout {
            spacing: 8px;
            SpinBox {
                minimum: 2;
                maximum: 32;
                value: root.notes;
                edited(v) => {
                    root.notes = v;
                    root.in-time-of = root.usual(v);
                }
            }
            Text { text: "notes in the time of"; vertical-alignment: center; font-size: 12px; }
            SpinBox {
                minimum: 1;
                maximum: 32;
                value: root.in-time-of;
                edited(v) => { root.in-time-of = v; }
            }
        }
    }
}

// Copy Bars, Cut Bars and Paste Bars (#287): the caret's track or every
// track, and for Paste Bars whether the new bars go before or after the
// selected ones.
export component BarsDialog inherits Rectangle {
    in property <string> heading: "Copy Bars";
    in property <bool> asks-place: false;
    in property <string> note;
    in-out property <bool> after: false;
    in-out property <bool> all-tracks: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 400px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            if root.asks-place : ComboBox {
                model: ["Before the selected bars", "After the selected bars"];
                current-index: root.after ? 1 : 0;
                selected => { root.after = self.current-index == 1; }
            }
            ComboBox {
                model: ["Only this track", "All tracks"];
                current-index: root.all-tracks ? 1 : 0;
                selected => { root.all-tracks = self.current-index == 1; }
            }
            if root.note != "" : Text {
                text: root.note;
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// Transpose… (slice 5): by semitones or by steps of the key, keeping the
// fingering or finding new frets. The heading names what it applies to.
export component TransposeDialog inherits Rectangle {
    in property <string> heading: "Transpose";
    in-out property <int> amount: 0;
    in-out property <bool> steps: false;
    in-out property <bool> keep-fingering: true;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 440px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "By"; vertical-alignment: center; font-size: 12px; }
                SpinBox {
                    minimum: -24;
                    maximum: 24;
                    value: root.amount;
                    edited(v) => { root.amount = v; }
                }
                ComboBox {
                    horizontal-stretch: 1;
                    model: ["semitones", "steps of the key"];
                    current-index: root.steps ? 1 : 0;
                    selected => { root.steps = self.current-index == 1; }
                }
            }
            Text {
                text: "Up is positive, down negative. Steps of the key keep the music in its key.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
            CheckBox {
                text: "Keep the fingering (else find new frets)";
                checked: root.keep-fingering;
                toggled => { root.keep-fingering = self.checked; }
            }
        }
    }
}

// Fit Bars to Time Signature… (#222): re-bar the music across the bar
// lines, or stretch each bar to fill its time signature. The heading
// names what it applies to.
export component FitDialog inherits Rectangle {
    in property <string> heading: "Fit Bars to Time Signature";
    in-out property <bool> stretch: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 460px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            ComboBox {
                model: ["Re-bar: notes keep their lengths", "Stretch: each bar keeps its notes"];
                current-index: root.stretch ? 1 : 0;
                selected => { root.stretch = self.current-index == 1; }
            }
            Text {
                text: root.stretch
                    ? "Each bar that doesn't add up keeps its notes, scaled to fill its time signature, with tuplets where needed. The bars stay where they are."
                    : "The music flows across the bar lines: notes that cross one are tied, and bars are added or removed in every track. Repeats, endings and sections keep their bar lines.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
            Text {
                text: "Only bars that don't add up change, in every track.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// Harmonize… (#235): chords found for the notes of every track, or of
// the caret's alone, and written on the caret's track. `part` names what
// is harmonized when the whole song isn't ("the selected bars").
export component HarmonizeDialog inherits Rectangle {
    in property <string> heading: "Harmonize";
    in property <string> part: "this bar";
    in-out property <bool> sevenths: false;
    in-out property <bool> inside-bars: false;
    in-out property <bool> keep: false;
    in-out property <bool> all-tracks: true;
    in-out property <bool> whole-song: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 460px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            ComboBox {
                model: ["Major, minor and diminished chords", "Sevenths and suspended chords too"];
                current-index: root.sevenths ? 1 : 0;
                selected => { root.sevenths = self.current-index == 1; }
            }
            ComboBox {
                model: ["One chord a bar at most", "Chords may change inside a bar"];
                current-index: root.inside-bars ? 1 : 0;
                selected => { root.inside-bars = self.current-index == 1; }
            }
            ComboBox {
                model: ["Replace the chords already there", "Keep the chords already there"];
                current-index: root.keep ? 1 : 0;
                selected => { root.keep = self.current-index == 1; }
            }
            ComboBox {
                model: ["Listen to every track but drums", "Listen to this track only"];
                current-index: root.all-tracks ? 0 : 1;
                selected => { root.all-tracks = self.current-index == 0; }
            }
            CheckBox {
                text: "Harmonize the whole song, not only " + root.part;
                checked <=> root.whole-song;
            }
            Text {
                text: "The chords are found in the key of the bars' key signature and written above this track with their diagrams.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// Merge Into… (#312): the clicked track's notes written into another
// track (`tracks`, every track of its kind but itself), then the clicked
// track deleted. One voice goes into the voice picked; several go voice
// by voice.
export component MergeDialog inherits Rectangle {
    in property <string> heading: "Merge Into";
    in property <[string]> tracks;
    in-out property <int> into: 0;
    in-out property <bool> voice1: true;
    in-out property <bool> voice2: false;
    in-out property <bool> voice3: false;
    in-out property <bool> voice4: false;
    in-out property <int> to-voice: 0;
    in-out property <bool> discard-unisons: false;
    callback done(bool);
    property <int> picked: (root.voice1 ? 1 : 0) + (root.voice2 ? 1 : 0) + (root.voice3 ? 1 : 0) + (root.voice4 ? 1 : 0);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 460px;
        ok-enabled: root.picked > 0;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Into"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.tracks;
                    current-index: root.into;
                    selected => { root.into = self.current-index; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Its voices"; }
                CheckBox { text: "1"; checked <=> root.voice1; }
                CheckBox { text: "2"; checked <=> root.voice2; }
                CheckBox { text: "3"; checked <=> root.voice3; }
                CheckBox { text: "4"; checked <=> root.voice4; }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Into voice"; }
                ComboBox {
                    horizontal-stretch: 1;
                    enabled: root.picked == 1;
                    model: root.picked > 1 ? ["Each into the same voice"] : ["Voice 1", "Voice 2", "Voice 3", "Voice 4"];
                    current-index: root.picked > 1 ? 0 : root.to-voice;
                    selected => {
                        if (root.picked == 1) {
                            root.to-voice = self.current-index;
                        }
                    }
                }
            }
            CheckBox {
                text: "Discard unisons";
                checked <=> root.discard-unisons;
            }
            Text {
                text: "Where the rhythms differ, notes are cut and tied. Notes keep their strings where they can. A unison is a note the other track plays at the same pitch at the same moment. This track is then deleted.";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// A point of a bend curve on the editor's grid (`bend_form::Point`).
export struct GridPoint {
    col: int,
    row: int,
}

// A plugin's dialog (plugin interface 1.8): the plugin's own widgets and
// canvas, as its tabs have them, on a card with OK and Cancel.
export component PluginDialog inherits Rectangle {
    in property <string> heading;
    in property <[PluginRow]> rows;
    in property <string> message;
    callback clicked(string);
    callback toggled(string, bool);
    callback slid(string, float);
    callback edited(string, string);
    callback chosen(string, int);
    callback pointer(string, int, float, float, int);
    callback canvas-room(string, length, length);
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 520px;
        done(ok) => { root.done(ok); }
        PluginTab {
            min-height: 120px;
            preferred-height: 420px;
            rows: root.rows;
            message: root.message;
            clicked(id) => { root.clicked(id); }
            toggled(id, on) => { root.toggled(id, on); }
            slid(id, v) => { root.slid(id, v); }
            edited(id, text) => { root.edited(id, text); }
            chosen(id, i) => { root.chosen(id, i); }
            pointer(id, k, x, y, b) => { root.pointer(id, k, x, y, b); }
            canvas-room(id, w, h) => { root.canvas-room(id, w, h); }
        }
    }
}

// The bend and whammy-bar editor (M3 slice 6; `bend_form.rs`): a type, a
// pitch, and a curve whose points are dragged on a grid of twelfths of the
// note by quarter tones.
export component BendDialog inherits Rectangle {
    in property <string> heading: "Bend";
    in property <[string]> types;
    in property <[string]> amounts;
    in-out property <int> kind;
    in-out property <int> amount;
    // The lowest and highest rows (quarter tones).
    in property <int> low: 0;
    in property <int> high: 12;
    in property <[GridPoint]> points;
    // The curve as SVG path data, 10 units a cell.
    in property <string> path;
    callback kind-picked(int);
    callback amount-picked(int);
    callback pressed(float, float);
    callback dragged(float, float);
    callback released();
    callback done(bool);
    property <length> grid-w: 360px;
    property <length> grid-h: 240px;
    property <length> cell-w: self.grid-w / 12;
    property <length> cell-h: self.grid-h / (self.high - self.low);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        card-width: 460px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.types;
                    current-index <=> root.kind;
                    selected => { root.kind-picked(self.current-index); }
                }
                ComboBox {
                    model: root.amounts;
                    current-index <=> root.amount;
                    selected => { root.amount-picked(self.current-index); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                // Whole tones up the side.
                Rectangle {
                    width: 34px;
                    height: root.grid-h;
                    for i in (root.high - root.low) / 4 + 1 : Text {
                        property <int> tones: (root.high - i * 4) / 4;
                        x: 0;
                        y: i * 4 * root.cell-h - 7px;
                        width: 30px;
                        horizontal-alignment: right;
                        font-size: 11px;
                        color: Palette.foreground;
                        opacity: 0.7;
                        text: self.tones == 0 ? "0" : self.tones < 0 ? "−" + (-self.tones) : self.tones;
                    }
                }
                Rectangle {
                    width: root.grid-w;
                    height: root.grid-h;
                    background: Palette.alternate-background;
                    border-color: Palette.border;
                    border-width: 1px;
                    for i in 13 : Rectangle {
                        x: i * root.cell-w;
                        y: 0;
                        width: 1px;
                        height: root.grid-h;
                        background: Palette.border;
                        opacity: mod(i, 3) == 0 ? 0.9 : 0.4;
                    }
                    for i in root.high - root.low + 1 : Rectangle {
                        x: 0;
                        y: i * root.cell-h;
                        width: root.grid-w;
                        height: root.high - i == 0 ? 2px : 1px;
                        background: Palette.border;
                        opacity: mod(root.high - i, 4) == 0 ? 0.9 : 0.35;
                    }
                    Path {
                        x: 0;
                        y: 0;
                        width: root.grid-w;
                        height: root.grid-h;
                        commands: root.path;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 120;
                        viewbox-height: (root.high - root.low) * 10;
                        fit: fill;
                        stroke: #2e9d5b;
                        stroke-width: 2px;
                    }
                    for p in root.points : Rectangle {
                        x: p.col * root.cell-w - 5px;
                        y: (root.high - p.row) * root.cell-h - 5px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: #2e9d5b;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.pressed(self.mouse-x / root.cell-w, root.high - self.mouse-y / root.cell-h);
                            }
                            if (e.kind == PointerEventKind.up) {
                                root.released();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.dragged(self.mouse-x / root.cell-w, root.high - self.mouse-y / root.cell-h);
                            }
                        }
                    }
                }
            }
            Text {
                text: "Drag the points: time across the note, pitch up the side in quarter tones. Enter applies; Escape cancels.";
                font-size: 11px;
                wrap: word-wrap;
                opacity: 0.7;
            }
        }
    }
}

// Text above a beat (M3 slice 6): one line; empty for none.
export component TextDialog inherits Rectangle {
    in-out property <string> text;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: "Text";
        card-width: 400px;
        takes-focus: false;
        done(ok) => { root.done(ok); }
        // Escape cancels from the field too.
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.done(false);
                    return accept;
                }
                reject
            }
            LineEdit {
                text <=> root.text;
                placeholder-text: "Text above the beat";
                init => { self.focus(); }
                accepted => { root.done(true); }
            }
        }
    }
}

// A field with a list to pick from: what an editable ComboBox would be
// (Slint's, up to 1.19 at least, takes no typing). The list opens under the field.
component EditCombo inherits Rectangle {
    in-out property <string> text;
    in property <[string]> model;
    // Whether the field takes the keyboard when it appears.
    in property <bool> first: false;
    callback edited(string);
    callback picked(int);
    callback accepted();
    HorizontalLayout {
        spacing: 2px;
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.text;
            init => {
                if (root.first) {
                    self.focus();
                }
            }
            edited(t) => { root.edited(t); }
            accepted => { root.accepted(); }
        }
        Rectangle {
            width: 26px;
            border-radius: 4px;
            background: arrow.has-hover ? Palette.control-background : transparent;
            opacity: root.model.length > 0 ? 1 : 0.3;
            Path {
                width: 10px;
                height: 6px;
                commands: "M 0 0 L 5 6 L 10 0";
                stroke: Palette.foreground;
                stroke-width: 1.5px;
            }
            arrow := TouchArea {
                enabled: root.model.length > 0;
                clicked => { list.show(); }
            }
        }
    }
    list := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;
        }
        VerticalLayout {
            padding: 4px;
            for item[i] in root.model : Rectangle {
                height: 24px;
                border-radius: 3px;
                background: row.has-hover ? Palette.control-background : transparent;
                Text {
                    x: 8px;
                    height: parent.height;
                    text: item;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                row := TouchArea { clicked => { root.picked(i); } }
            }
        }
    }
}

// A label of the chord dialog's narrow first column.
component ChordLabel inherits Text {
    font-size: 12px;
    vertical-alignment: center;
    width: 52px;
}

// The chord dialog (#278; `chord_form.rs`): a name, a voicing in inline
// notation and a diagram that follow one another, and the chord notation
// style names are shown in.
export component ChordDialog inherits Rectangle {
    in-out property <string> name;
    in property <[string]> names;
    in-out property <string> voicing;
    in property <[string]> voicings;
    in property <[string]> styles;
    in-out property <int> style-index;
    // Strings, and each string's dot, low to high: the row (0 the first
    // fret shown), -1 open, -2 not played, -3 off the grid.
    in property <int> strings: 6;
    in property <[int]> dots;
    in-out property <int> first-fret: 1;
    in property <int> last-fret: 24;
    in property <bool> add-diagram: true;
    callback name-typed(string);
    callback name-picked(int);
    callback voicing-typed(string);
    callback voicing-picked(int);
    callback style-picked(int);
    callback apply-style();
    callback grid-clicked(int, int);
    callback head-clicked(int);
    callback scrolled(int);
    callback add-toggled(bool);
    callback done(bool);
    property <length> cell-w: 28px;
    property <length> cell-h: 30px;
    property <length> grid-w: (root.strings - 1) * root.cell-w;
    Card {
        width: root.width;
        height: root.height;
        heading: "Chord";
        card-width: 350px;
        takes-focus: false;
        done(ok) => { root.done(ok); }
        // Escape cancels from the fields too.
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.done(false);
                    return accept;
                }
                reject
            }
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    ChordLabel { text: "Name"; }
                    EditCombo {
                        first: true;
                        text <=> root.name;
                        model: root.names;
                        edited(t) => { root.name-typed(t); }
                        picked(i) => { root.name-picked(i); }
                        accepted => { root.done(true); }
                    }
                }
                if root.strings > 1 : HorizontalLayout {
                    spacing: 8px;
                    ChordLabel { text: "Voicing"; }
                    EditCombo {
                        text <=> root.voicing;
                        model: root.voicings;
                        edited(t) => { root.voicing-typed(t); }
                        picked(i) => { root.voicing-picked(i); }
                        accepted => { root.done(true); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ChordLabel { text: "Style"; }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.styles;
                        current-index <=> root.style-index;
                        selected => { root.style-picked(self.current-index); }
                    }
                    Button { text: "Apply"; clicked => { root.apply-style(); } }
                }
                if root.strings > 1 : HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Rectangle {
                        width: root.grid-w + root.cell-w;
                        height: 5 * root.cell-h + 26px;
                        opacity: root.add-diagram ? 1 : 0.5;
                        // Above the strings: an open circle for an open
                        // string, a cross for one not played.
                        for d[i] in root.dots : Rectangle {
                            x: root.cell-w / 2 + i * root.cell-w - 10px;
                            y: 0;
                            width: 20px;
                            height: 20px;
                            if d == -1 : Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                border-width: 1.5px;
                                border-color: Palette.foreground;
                            }
                            if d == -2 : Text {
                                text: "×";
                                font-size: 14px;
                                opacity: 0.6;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.head-clicked(i); } }
                        }
                        Rectangle {
                            x: root.cell-w / 2;
                            y: 24px;
                            width: root.grid-w;
                            height: 5 * root.cell-h;
                            // The nut, thick at the first fret.
                            Rectangle {
                                y: 0;
                                height: root.first-fret == 1 ? 4px : 1px;
                                background: Palette.foreground;
                            }
                            for i in 6 : Rectangle {
                                y: i * root.cell-h;
                                height: 1px;
                                background: Palette.foreground;
                                opacity: 0.6;
                            }
                            for i in root.strings : Rectangle {
                                x: i * root.cell-w;
                                width: 1px;
                                background: Palette.foreground;
                                opacity: 0.6;
                            }
                            for d[i] in root.dots : Rectangle {
                                visible: d >= 0;
                                x: i * root.cell-w - 9px;
                                y: max(d, 0) * root.cell-h + root.cell-h / 2 - 9px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: Palette.foreground;
                            }
                            TouchArea {
                                x: -root.cell-w / 2;
                                width: root.grid-w + root.cell-w;
                                clicked => {
                                    root.grid-clicked(
                                        clamp(round((self.mouse-x - root.cell-w / 2) / root.cell-w), 0, root.strings - 1),
                                        clamp(floor(self.mouse-y / root.cell-h), 0, 4));
                                }
                            }
                        }
                    }
                    // The diagram's first fret.
                    VerticalLayout {
                        alignment: start;
                        padding-top: 24px;
                        SpinBox {
                            width: 76px;
                            minimum: 1;
                            maximum: root.last-fret;
                            value <=> root.first-fret;
                            edited(v) => { root.scrolled(v); }
                        }
                    }
                }
                if root.strings > 1 : HorizontalLayout {
                    alignment: start;
                    CheckBox {
                        text: "Add diagram";
                        checked: root.add-diagram;
                        toggled => { root.add-toggled(self.checked); }
                    }
                }
            }
        }
    }
}

// File → Export of an audio exporter (M4 slice 7, PLAY-7): what to render
// before the file dialog. The whole song or the selected bars, at the
// written tempo or the practice speed, with or without the metronome.
export component ExportDialog inherits Rectangle {
    in property <string> heading: "Export Audio";
    // Where the file's format is set: the exporter's plugin's settings.
    in property <string> plugin-name;
    in property <bool> has-selection: false;
    in-out property <bool> selection: false;
    in property <int> practice-speed: 100;
    in-out property <bool> at-speed: false;
    in-out property <bool> metronome: false;
    callback done(bool);
    Card {
        width: root.width;
        height: root.height;
        heading: root.heading;
        ok-text: "Export…";
        card-width: 440px;
        done(ok) => { root.done(ok); }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Label { text: "What"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.has-selection ? ["The whole song", "The selected bars"] : ["The whole song"];
                    current-index: root.selection && root.has-selection ? 1 : 0;
                    selected => { root.selection = self.current-index == 1; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Tempo"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.practice-speed == 100
                        ? ["As written"]
                        : ["As written", "At the practice speed (" + root.practice-speed + " %)"];
                    current-index: root.at-speed && root.practice-speed != 100 ? 1 : 0;
                    selected => { root.at-speed = self.current-index == 1; }
                }
            }
            CheckBox {
                text: "The metronome's clicks in the sound";
                checked: root.metronome;
                toggled => { root.metronome = self.checked; }
            }
            Text {
                text: "Each track plays with its sound, amp and mixer settings as they are now. The file's format (bit depth, rate) is set in the settings of the plugin “" + root.plugin-name + "” (Tools → Plugins…, its Settings… button).";
                font-size: 11px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.4);
            }
        }
    }
}

// An audio export under way: how far it has got, and Cancel. Over the
// window, so nothing changes the score while it renders.
export component ExportProgress inherits Rectangle {
    in property <string> status;
    in property <float> progress;
    callback cancel();
    background: #00000060;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
            }
            accept
        }
    }
    Rectangle {
        width: min(400px, root.width - 40px);
        height: box.preferred-height;
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        box := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: root.status; font-size: 13px; wrap: word-wrap; }
            Rectangle {
                height: 8px;
                border-radius: 4px;
                background: Palette.alternate-background;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    border-radius: 4px;
                    background: #4488FF;
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

