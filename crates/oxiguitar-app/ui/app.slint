// The OxiGuitar window, following docs/design/ui.md: the menus; a toolbar
// of sections; four tabbed areas (top and bottom across the window, left
// and right beside the page) that collapse to their tab strip and hide from
// View → Panels; the page in the middle, on a dark canvas, with its zoom
// slider in the corner; and a one-line footer of messages that expands.
// The core's tabs and toolbar sections come from shell.rs, so plugins can
// add theirs to the same lists (docs/design/plugins.md). The score is drawn
// by our renderer on the worker thread and shown here as tiles.

import { Slider, ScrollView, Palette, ComboBox, Button, CheckBox, SpinBox, LineEdit, TextEdit } from "std-widgets.slint";
import { PluginTab, PluginRow, PluginWidget } from "plugin_tab.slint";
import { AltBox, BarDialog, BarFields, BendDialog, ChordDialog, GridPoint, PasteDialog, TextDialog, TupletDialog, TrackDialog, TrackFields, TransposeDialog } from "bar_dialog.slint";
// The plugin manager's own window (Tools → Plugins).
export { PluginManagerWindow, ManagerRow } from "plugin_manager.slint";
import "../../../assets/fonts/noto-sans/NotoSans-Regular.ttf";

export struct TileItem {
    image: image,
    x: length,
    y: length,
    size: length,
}

// A box over the page, in canvas points (the editor's caret and selection;
// editing.rs). The window places it with the origin and the zoom, so it
// follows resizing and zooming by itself.
export struct BoxItem {
    x: float,
    y: float,
    w: float,
    h: float,
}

export struct TrackRow {
    name: string,
    shown: bool,
    // The notation buttons: standard notation and tablature (both off when
    // the track is hidden), and whether the track has strings to tab.
    standard: bool,
    tablature: bool,
    can-tab: bool,
    // The mixer (Mateus, 19 Oct 2026: no tab of its own): volume 0 to 1,
    // pan -1 (left) to 1 (right), mute and solo, as the file sets them.
    volume: float,
    pan: float,
    mute: bool,
    solo: bool,
    // The track across the song (tracks.rs, waveform): SVG path data in a
    // box `bars` wide and 2 high.
    wave: string,
    bars: int,
}

// The editor's palette (palette.rs): every tool greyed out until M3.
export struct PaletteToolRow {
    // The tool's id (palette.rs), for the editor to act on.
    id: string,
    icon: image,
    tip: string,
    enabled: bool,
    // On (the caret's voice, for the voice buttons).
    checked: bool,
}

export struct PaletteGroupRow {
    title: string,
    collapsed: bool,
    tools: [PaletteToolRow],
}

export struct ToolRow {
    title: string,
    enabled: bool,
}

export struct ToolbarItemRow {
    id: string,
    icon: image,
    tip: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export struct ToolbarSectionRow {
    title: string,
    items: [ToolbarItemRow],
}

// One area's tabs: their titles, the one showing (and its id, which picks
// what is drawn inside), and whether the area is collapsed to its strip.
export struct AreaState {
    titles: [string],
    active: int,
    active-id: string,
    collapsed: bool,
    // The open tab is a plugin's.
    plugin: bool,
}

export struct FooterRow {
    // 0 info, 1 warning, 2 error.
    level: int,
    text: string,
}

// The canvas behind the page: the same colour with or without Dark Page
// (Mateus, 18 Oct 2026), a touch lighter than Fluent's darkest background
// so the page area reads as its own surface.
global Look {
    out property <color> canvas: #242528;
    out property <color> on-canvas: #ffffff80;
    out property <color> warning: #d39a2c;
    out property <color> error: #d9534f;
    // The caret, the selection and the selected track: the score's accent,
    // between its light and dark pages' greens so it reads on both.
    out property <color> accent: #3aa55f;
}

// A level's dot in the footer.
component LevelDot inherits Rectangle {
    in property <int> level;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.level == 2 ? Look.error : root.level == 1 ? Look.warning : Palette.foreground.transparentize(0.5);
}

// A square icon button: our own SVG icons, tinted by the theme, greyed out
// when disabled, highlighted when a toggle is on.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked();

    width: 30px;
    height: 28px;
    border-radius: 4px;
    background: root.checked ? Palette.accent-background
        : touch.has-hover && root.enabled ? Palette.control-background.darker(0.15) : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.checked ? Palette.accent-foreground
            : root.enabled ? Palette.foreground.transparentize(0.1) : Palette.foreground.transparentize(0.7);
    }
    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

// A notation button: a symbol drawn by our renderer and centred on its ink,
// highlighted when on, like the palette buttons of the GUI spike. The
// mixer's mute and solo toggles are drawn and highlighted the same way,
// and greyed out until an output plugin is installed.
component NotationButton inherits Rectangle {
    in property <image> icon;
    in property <bool> on;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 26px;
    border-radius: 4px;
    background: root.on && root.enabled ? Palette.accent-background
        : root.on ? Palette.accent-background.transparentize(0.6)
        : touch.has-hover && root.enabled ? Palette.control-background.darker(0.15) : Palette.control-background;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Palette.accent-background.brighter(0.4) : Palette.border;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.on ? Palette.accent-foreground : Palette.control-foreground.transparentize(0.25);
    }
    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

// The pan knob: a dial whose mark points left at -1, up at 0 and right at
// 1, over 270 degrees. Drag up or right to turn it right; arrow keys move
// it a tenth; a double click centres it.
component Knob inherits Rectangle {
    in-out property <float> value;
    in property <bool> enabled: true;
    in property <string> tip;
    callback changed(float);
    property <float> pressed-value;
    property <angle> turn: root.value * 135deg;

    width: 22px;
    height: 22px;
    border-radius: self.width / 2;
    background: Palette.control-background;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Palette.accent-background.brighter(0.4) : Palette.border;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: slider;
    accessible-label: root.tip;
    accessible-value: round(root.value * 100);
    accessible-value-minimum: -100;
    accessible-value-maximum: 100;
    accessible-enabled: root.enabled;

    function set(v: float) {
        root.value = clamp(v, -1, 1);
        root.changed(root.value);
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 22;
        viewbox-height: 22;
        stroke: root.enabled ? Palette.accent-background : Palette.foreground.transparentize(0.3);
        stroke-width: 2.5px;
        MoveTo { x: 11 + 1.5 * sin(root.turn); y: 11 - 1.5 * cos(root.turn); }
        LineTo { x: 11 + 9 * sin(root.turn); y: 11 - 9 * cos(root.turn); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed-value = root.value;
            }
        }
        moved => {
            if (self.pressed) {
                root.set(root.pressed-value + ((self.mouse-x - self.pressed-x) - (self.mouse-y - self.pressed-y)) / 60px);
            }
        }
        double-clicked => { root.set(0); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.set(root.value + 0.1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.set(root.value - 0.1);
                return accept;
            }
            reject
        }
    }
    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

// A palette tool: its icon drawn by our renderer, centred on its ink, at
// the button's size. Greyed out until the editor; the tooltip says so.
component PaletteButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> enabled;
    in property <bool> checked;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: root.checked ? Look.accent.transparentize(0.6)
        : touch.has-hover && root.enabled ? Palette.control-background : transparent;
    border-width: root.checked ? 1px : 0;
    border-color: Look.accent;
    accessible-checked: root.checked;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: 32px;
        height: 32px;
        colorize: root.enabled ? Palette.foreground.transparentize(0.1) : Palette.foreground.transparentize(0.62);
    }
    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

// The palette: its groups under headings that collapse and expand with a
// click, each group's buttons wrapping to the area's width (ui.md,
// "Palette").
// The palette's search field (M3 slice 6; Ctrl + F): it filters the tools
// by name. Escape clears it; Enter goes back to the page.
component PaletteSearch inherits Rectangle {
    in-out property <string> query;
    // Raised by one to take the keyboard (Ctrl + F).
    in property <int> focus-requests;
    callback searched(string);
    callback done(bool);
    changed focus-requests => { edit.focus(); }
    height: self.preferred-height;
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.done(true);
                return accept;
            }
            reject
        }
        HorizontalLayout {
            padding: 6px;
            padding-bottom: 2px;
            edit := LineEdit {
                text <=> root.query;
                placeholder-text: "Search (Ctrl + F)";
                edited(t) => { root.searched(t); }
                accepted => { root.done(false); }
            }
        }
    }
}

component PaletteView inherits ScrollView {
    in property <[PaletteGroupRow]> groups;
    // While searching, the tools found, in one grid.
    in property <bool> searching;
    in property <[PaletteToolRow]> found;
    in property <image> chevron-open;
    in property <image> chevron-closed;
    callback group-clicked(int);
    callback tool-clicked(string);
    property <length> cell: 34px;
    property <int> columns: max(1, floor((self.visible-width - 12px) / root.cell));

    VerticalLayout {
        alignment: start;
        padding: 6px;
        padding-top: 4px;
        spacing: 2px;
        if root.searching && root.found.length == 0 : Text {
            text: "No tool has that name";
            font-size: 11px;
            color: Palette.foreground.transparentize(0.4);
        }
        if root.searching : Rectangle {
            height: ceil(root.found.length / root.columns) * root.cell;
            for tool[i] in root.found : PaletteButton {
                x: mod(i, root.columns) * root.cell;
                y: floor(i / root.columns) * root.cell;
                icon: tool.icon;
                tip: tool.tip;
                enabled: tool.enabled;
                checked: tool.checked;
                clicked => { root.tool-clicked(tool.id); }
            }
        }
        for group[g] in root.groups : VerticalLayout {
            visible: !root.searching;
            height: root.searching ? 0 : self.preferred-height;
            spacing: 2px;
            Rectangle {
                height: 22px;
                accessible-role: button;
                accessible-label: group.title;
                accessible-expanded: !group.collapsed;
                accessible-expandable: true;
                heading-touch := TouchArea {
                    clicked => { root.group-clicked(g); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Image {
                        width: 12px;
                        source: group.collapsed ? root.chevron-closed : root.chevron-open;
                        colorize: Palette.foreground.transparentize(heading-touch.has-hover ? 0.2 : 0.5);
                    }
                    Text {
                        text: group.title;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: Palette.foreground.transparentize(heading-touch.has-hover ? 0.1 : 0.35);
                    }
                }
            }
            if !group.collapsed : Rectangle {
                height: ceil(group.tools.length / root.columns) * root.cell;
                for tool[i] in group.tools : PaletteButton {
                    x: mod(i, root.columns) * root.cell;
                    y: floor(i / root.columns) * root.cell;
                    icon: tool.icon;
                    tip: tool.tip;
                    enabled: tool.enabled;
                    checked: tool.checked;
                    clicked => { root.tool-clicked(tool.id); }
                }
            }
        }
    }
}

// A track across the song, like a waveform: how much it plays in each bar
// (Mateus, 19 Oct 2026), with the playback position as a mark. Until the
// player (M4) the mark is a placeholder, greyed out at the start of the song.
component TrackOverview inherits Rectangle {
    in property <string> wave;
    in property <int> bars;
    in property <bool> shown;
    // 0 (start) to 1 (end of the song).
    in property <float> position;

    border-radius: 3px;
    background: Palette.control-background.transparentize(0.4);
    clip: true;
    Path {
        x: 4px;
        y: 3px;
        width: parent.width - 8px;
        height: parent.height - 6px;
        commands: root.wave;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: max(1, root.bars);
        viewbox-height: 2;
        fit: fill;
        fill: Palette.foreground.transparentize(root.shown ? 0.45 : 0.75);
    }
    // The playback position: a line with a playhead on top.
    property <length> mark-x: 4px + clamp(root.position, 0, 1) * (root.width - 8px);
    Rectangle {
        x: root.mark-x - self.width / 2;
        width: 2px;
        height: parent.height;
        background: Palette.foreground.transparentize(0.45);
    }
    Path {
        x: root.mark-x - 4px;
        y: 0;
        width: 8px;
        height: 6px;
        viewbox-width: 8;
        viewbox-height: 6;
        fill: Palette.foreground.transparentize(0.45);
        commands: "M0 0 L8 0 L4 6 Z";
    }
    Tooltip {
        text: @markdown("Playback position (comes with the player)");
    }
}

// Splitter bars: drag one to resize the area next to it. A Splitter sits
// above or below an area; a SideSplitter between the page and a side area.
component Splitter inherits Rectangle {
    callback dragged(length);
    height: 4px;
    background: ta.has-hover || ta.pressed ? Palette.accent-background : Palette.border;
    ta := TouchArea {
        mouse-cursor: row-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-y - self.pressed-y);
            }
        }
    }
}

component SideSplitter inherits Rectangle {
    callback dragged(length);
    width: 4px;
    background: ta.has-hover || ta.pressed ? Palette.accent-background : Palette.border;
    ta := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

// An area's tab strip: the tab names (click one to open it; click the open
// one to collapse or expand the area) and a chevron that does the same.
component TabStrip inherits Rectangle {
    in property <AreaState> state;
    // Which way the chevron points when the area is open: "down" for the
    // top area, "up" for the bottom one, "left" and "right" for the sides.
    in property <image> chevron-open;
    in property <image> chevron-closed;
    callback tab-clicked(int);
    callback chevron-clicked();

    height: 26px;
    background: Palette.alternate-background;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 2px;
        for title[i] in root.state.titles : Rectangle {
            width: label.preferred-width + 18px;
            border-radius: 4px;
            background: i == root.state.active && !root.state.collapsed ? Palette.control-background
                : tab-touch.has-hover ? Palette.control-background.transparentize(0.5) : transparent;
            label := Text {
                text: title;
                font-size: 12px;
                font-weight: i == root.state.active ? 600 : 400;
                vertical-alignment: center;
                horizontal-alignment: center;
                color: Palette.foreground.transparentize(i == root.state.active ? 0 : 0.3);
            }
            tab-touch := TouchArea {
                clicked => { root.tab-clicked(i); }
            }
        }
        Rectangle { }
        IconButton {
            width: 24px;
            height: 24px;
            icon: root.state.collapsed ? root.chevron-closed : root.chevron-open;
            tip: root.state.collapsed ? "Expand" : "Collapse";
            clicked => { root.chevron-clicked(); }
        }
    }
}

// A side area collapsed: a thin strip with a chevron to open it again.
component SideStrip inherits Rectangle {
    in property <image> chevron;
    in property <string> tip;
    callback clicked();
    width: 26px;
    background: strip-touch.has-hover ? Palette.control-background : Palette.alternate-background;
    // The whole strip opens the area, not only its chevron.
    strip-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    IconButton {
        y: 2px;
        width: 24px;
        height: 24px;
        icon: root.chevron;
        tip: root.tip;
        clicked => { root.clicked(); }
    }
}

// What a tab shows before its feature exists.
component Placeholder inherits Rectangle {
    in property <string> text;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Palette.foreground.transparentize(0.5);
    }
}

// One voice of the caret's bar in the Inspector (inspector.rs).
export struct InspectorVoice {
    name: string,
    count: string,
    state: string,
    // 0 full, 1 short, 2 too long, 3 nothing to compare.
    fill: int,
    entered: int,
    current: bool,
}

// One row of the Inspector's note and beat (effect_form.rs).
export struct InspectorField {
    id: string,
    label: string,
    // 0 heading, 1 tickbox, 2 drop-down, 3 number, 4 button.
    kind: int,
    value: int,
    options: [string],
    min: int,
    max: int,
}

// The Inspector: the caret's bar, each voice's beats against the time
// signature (Mateus, 20 Oct 2026); then the caret's note and beat, whose
// effects and values it changes (M3 slice 6).
component Inspector inherits Rectangle {
    in property <string> heading;
    in property <string> unit;
    in property <string> caret;
    in property <[InspectorVoice]> voices;
    in property <[InspectorField]> fields;
    callback field-changed(string, int);
    scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            padding: 12px;
            spacing: 6px;
            alignment: start;
            Text { text: root.heading; font-size: 14px; font-weight: 700; }
            Text { text: root.unit; font-size: 11px; color: Palette.foreground.transparentize(0.4); wrap: word-wrap; }
            for v in root.voices : Rectangle {
                border-radius: 4px;
                background: v.current ? Look.accent.transparentize(0.85) : transparent;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: v.name; font-size: 12px; font-weight: v.current ? 700 : 400; }
                        Text {
                            text: v.count;
                            font-size: 12px;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                            color: v.fill == 0 ? Look.accent : v.fill == 1 ? Look.warning : v.fill == 2 ? Look.error : Palette.foreground;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: v.state;
                            font-size: 11px;
                            color: v.fill == 0 ? Look.accent : v.fill == 1 ? Look.warning : v.fill == 2 ? Look.error : Palette.foreground.transparentize(0.4);
                        }
                        Text {
                            text: v.entered == 1 ? "1 note or rest" : v.entered + " notes and rests";
                            font-size: 11px;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                }
            }
            Text { text: root.caret; font-size: 11px; color: Palette.foreground.transparentize(0.4); wrap: word-wrap; }
            for f in root.fields : VerticalLayout {
                if f.kind == 0 : Text {
                    text: f.label;
                    font-size: 13px;
                    font-weight: 700;
                }
                if f.kind == 1 : CheckBox {
                    text: f.label;
                    checked: f.value == 1;
                    toggled => { root.field-changed(f.id, self.checked ? 1 : 0); }
                }
                if f.kind == 2 : HorizontalLayout {
                    spacing: 6px;
                    // A row is as tall as its drop-down needs, however few
                    // rows the Inspector has (issue #105: a rest's one
                    // field filled the pane).
                    max-height: 40px;
                    Text { text: f.label; font-size: 12px; vertical-alignment: center; width: 40%; wrap: word-wrap; }
                    ComboBox {
                        vertical-stretch: 0;
                        min-width: 60px;
                        horizontal-stretch: 1;
                        model: f.options;
                        current-index: f.value;
                        selected => { root.field-changed(f.id, self.current-index); }
                    }
                }
                if f.kind == 3 : HorizontalLayout {
                    spacing: 6px;
                    Text { text: f.label; font-size: 12px; vertical-alignment: center; width: 40%; wrap: word-wrap; }
                    SpinBox {
                        min-width: 60px;
                        horizontal-stretch: 1;
                        minimum: f.min;
                        maximum: f.max;
                        value: f.value;
                        edited(v) => { root.field-changed(f.id, v); }
                    }
                }
                if f.kind == 4 : HorizontalLayout {
                    spacing: 6px;
                    Text { text: f.label; font-size: 12px; vertical-alignment: center; width: 40%; }
                    Text { text: f.options[0]; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "Edit…"; clicked => { root.field-changed(f.id, 0); } }
                }
            }
        }
    }
}

// One field of the Song tab.
export struct SongField {
    id: string,
    label: string,
    text: string,
    multiline: bool,
}

// The Song tab (M3 slice 6; Mateus, 20 Oct 2026: as Guitar Pro 8's Song
// Inspector): the score's information, in Guitar Pro's order. A field is
// set when Enter is pressed in it or the keyboard leaves it.
component SongView inherits Rectangle {
    in property <[SongField]> fields;
    callback edited(string, string);
    scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            padding: 12px;
            spacing: 6px;
            alignment: start;
            for f in root.fields : VerticalLayout {
                spacing: 2px;
                Text { text: f.label; font-size: 11px; color: Palette.foreground.transparentize(0.35); }
                if !f.multiline : LineEdit {
                    text: f.text;
                    accepted(t) => { root.edited(f.id, t); }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.edited(f.id, self.text);
                        }
                    }
                }
                if f.multiline : TextEdit {
                    height: 72px;
                    text: f.text;
                    wrap: word-wrap;
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.edited(f.id, self.text);
                        }
                    }
                }
            }
        }
    }
}

// A small framed note that closes when clicked anywhere.
component InfoPopup inherits PopupWindow {
    in property <string> heading;
    in property <[string]> lines;
    width: 420px;
    Rectangle {
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Text { text: root.heading; font-size: 14px; font-weight: 700; }
            for line in root.lines : Text { text: line; font-size: 12px; wrap: word-wrap; }
            @children
        }
    }
}

// A question over the whole window (saving, unsaved changes): a heading,
// lines of text, and buttons, the first the default (Enter) and the last
// the way out (Escape). Nothing behind it can be clicked while it shows.
component Question inherits Rectangle {
    in property <string> heading;
    in property <[string]> lines;
    in property <[string]> buttons;
    callback answered(int);
    background: #00000060;
    TouchArea { }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.answered(root.buttons.length - 1);
                return accept;
            }
            if (event.text == Key.Return) {
                root.answered(0);
                return accept;
            }
            accept
        }
    }
    Rectangle {
        width: min(520px, root.width - 40px);
        height: min(box.preferred-height, root.height - 40px);
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        box := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: root.heading; font-size: 15px; font-weight: 700; wrap: word-wrap; }
            ScrollView {
                min-height: min(lines-box.preferred-height, 40px);
                preferred-height: min(lines-box.preferred-height, 320px);
                lines-box := VerticalLayout {
                    spacing: 4px;
                    for line in root.lines : Text { text: line; font-size: 12px; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                for b[i] in root.buttons : Button {
                    text: b;
                    primary: i == 0;
                    clicked => { root.answered(i); }
                }
            }
        }
    }
}

// A rounded pill floating over the canvas.
component Pill inherits Rectangle {
    height: 26px;
    border-radius: 13px;
    background: Palette.background.with-alpha(0.9);
    border-color: Palette.border;
    border-width: 1px;
}

export component AppWindow inherits Window {
    // "song.gp — OxiGuitar", with a dot while the score differs from the
    // file (main.rs).
    in property <string> window-title: "OxiGuitar";
    title: root.window-title;
    // The window icon for X11, Windows and macOS. Wayland ignores it and
    // takes the icon of the desktop entry named by the app id (main.rs).
    icon: @image-url("../../../assets/icon/png/oxiguitar-256.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 400px;
    min-height: 300px;
    default-font-family: "Noto Sans";

    // The score canvas, in logical pixels: its size, where canvas point
    // (0, 0) sits, and the tiles drawn so far.
    in property <bool> has-score: false;
    in property <length> content-width;
    in property <length> content-height;
    in property <[TileItem]> tiles;
    // Tiles from before a zoom or a new engraving, shown under the new ones
    // until those cover the view (main.rs).
    in property <[TileItem]> old-tiles;
    // Logical pixels per canvas point (the score zoom).
    in property <float> pt-scale: 1.333;
    // The editor (M3): the caret's column over its staves, the box around
    // its string on the tablature, and the selection, in canvas points.
    in property <bool> caret-shown: false;
    in property <BoxItem> caret;
    in property <bool> string-shown: false;
    in property <BoxItem> caret-string;
    in property <[BoxItem]> selection-boxes;
    // The track the caret is in, highlighted in the track list.
    in property <int> selected-track: -1;
    // The Edit menu and the toolbar's Undo and Redo.
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <string> undo-title: "Undo";
    in property <string> redo-title: "Redo";
    // Some shown bar doesn't add up: Tools → Next Bar That Doesn't Add Up.
    in property <bool> bad-bars: false;
    out property <length> view-x: -flick.viewport-x;
    out property <length> view-y: -flick.viewport-y;
    out property <length> view-width: flick.visible-width;
    out property <length> view-height: flick.visible-height;
    // Where the page's viewport sits in the window, for the mouse wheel
    // (main.rs: the wheel zooms the page only over the page).
    out property <length> canvas-left: canvas.absolute-position.x;
    out property <length> canvas-top: canvas.absolute-position.y;
    out property <length> canvas-width: canvas.width;
    out property <length> canvas-height: canvas.height;
    // Pages are centred when narrower than the canvas.
    // Tiles sit on whole device pixels: at a fractional position Slint 1.17
    // blends their edges with the canvas behind, a faint line between tiles.
    // The origin is rounded, and the tiles are shifted by whatever fraction
    // the scroll position has (after a zoom around the pointer, say).
    out property <length> origin-x: round(max(24px, (flick.visible-width - root.content-width) / 2) / 1phx) * 1phx;
    out property <length> origin-y: round(24px / 1phx) * 1phx;
    property <length> snap-x: round(flick.viewport-x / 1phx) * 1phx - flick.viewport-x;
    property <length> snap-y: round(flick.viewport-y / 1phx) * 1phx - flick.viewport-y;

    // View settings.
    in-out property <int> layout: 0;
    in-out property <int> paper: 0;
    // One tick per menu item, kept in step by pick-layout and pick-paper.
    // A checkable item flips its own tick when clicked, which would break
    // a one-way binding such as "checked: layout == 0" for good, so every
    // tick here is two-way and set from one place.
    in-out property <bool> layout-0: true;
    in-out property <bool> layout-1: false;
    in-out property <bool> layout-2: false;
    in-out property <bool> layout-3: false;
    in-out property <bool> paper-0: true;
    in-out property <bool> paper-1: false;
    in-out property <bool> dark-page: false;
    // The window's own colours: dark by default with a white page (Mateus,
    // 18 Oct 2026); main.rs restores the user's choice from settings.json.
    in-out property <bool> dark-interface: true;
    init => { Palette.color-scheme = root.dark-interface ? ColorScheme.dark : ColorScheme.light; }
    changed dark-interface => { Palette.color-scheme = root.dark-interface ? ColorScheme.dark : ColorScheme.light; }
    in-out property <bool> dynamics: false;

    // The shell (shell.rs): the toolbar and the four areas, numbered
    // 0 top, 1 bottom, 2 left, 3 right. The View menu's ticks show or hide
    // them; collapsing and tabs go through tab-clicked and area-toggled.
    in-out property <bool> toolbar-shown: true;
    in-out property <bool> top-shown: true;
    in-out property <bool> bottom-shown: true;
    in-out property <bool> left-shown: true;
    in-out property <bool> right-shown: true;
    in property <[ToolbarSectionRow]> toolbar;
    in property <AreaState> top-area;
    in property <AreaState> bottom-area;
    in property <AreaState> left-area;
    in property <AreaState> right-area;
    in-out property <length> top-height: 44px;
    in-out property <length> bottom-height: 120px;
    in-out property <length> left-width: 220px;
    in-out property <length> right-width: 240px;

    in property <[TrackRow]> tracks;
    in property <[ToolRow]> tools;
    in property <[PaletteGroupRow]> palette-groups;
    callback palette-group-clicked(int);
    callback palette-tool-clicked(string);

    // The player (top area). Off until an output plugin is installed.
    in property <bool> player-available: false;
    // Where the player is in the song, 0 to 1; the start until M4.
    in property <float> song-position: 0;
    in property <[string]> outputs: ["No output plugin"];

    // Score zoom as log2 of the zoom factor: -2 is 25 %, 0 is 100 %, 2 is 400 %.
    in-out property <float> zoom-log: 0;
    in property <string> zoom-text: "100 %";

    // The footer: the latest message, how many there are, and all of them
    // (newest first) when expanded.
    in property <string> footer-text;
    in property <int> footer-level;
    in property <int> footer-count;
    in property <[FooterRow]> footer-rows;
    in-out property <bool> footer-expanded: false;

    in property <[string]> shortcut-lines;
    in property <[string]> about-lines;
    // Help → About's donation button (links.rs opens the page in the browser).
    callback open-donation();

    callback open-file();
    callback new-file();
    // The Edit menu's note items, by name (editing.rs, `menu_command`).
    callback edit-command(string);
    callback save();
    callback save-as();
    // The question over the window (saving, unsaved changes).
    in property <bool> question-shown: false;
    in property <string> question-heading;
    in property <[string]> question-lines;
    in property <[string]> question-buttons;
    callback question-answered(int);
    // The Bar dialog and Custom N-tuplet (bar_form.rs).
    in property <bool> bar-dialog-shown: false;
    in-out property <BarFields> bar-fields;
    in-out property <[bool]> bar-endings;
    in-out property <[bool]> bar-directions;
    in property <[string]> bar-key-names;
    in property <[string]> bar-clef-names;
    in property <[string]> bar-feel-names;
    in property <[string]> bar-direction-names;
    in property <string> bar-heading: "Bar";
    callback bar-dialog-done(bool);
    in property <bool> tuplet-dialog-shown: false;
    in-out property <int> tuplet-notes: 3;
    in-out property <int> tuplet-in-time-of: 2;
    pure callback tuplet-usual(int) -> int;
    callback tuplet-dialog-done(bool);
    // The bend and whammy-bar editor (bend_form.rs).
    in property <bool> bend-dialog-shown: false;
    in property <string> bend-heading: "Bend";
    in property <[string]> bend-types;
    in property <[string]> bend-amounts;
    in-out property <int> bend-kind;
    in-out property <int> bend-amount;
    in property <int> bend-low: 0;
    in property <int> bend-high: 12;
    in property <[GridPoint]> bend-points;
    in property <string> bend-path;
    callback bend-kind-picked(int);
    callback bend-amount-picked(int);
    callback bend-pressed(float, float);
    callback bend-dragged(float, float);
    callback bend-released();
    callback bend-dialog-done(bool);
    // Text, lyrics and chords (M3 slice 6).
    in property <bool> text-dialog-shown: false;
    in-out property <string> text-dialog-text;
    callback text-dialog-done(bool);
    // Lyrics typed on the page (Ctrl + T): a field under the beat, at
    // canvas points (lyric-x the beat's middle, lyric-y the baseline).
    in property <bool> lyric-shown: false;
    in property <float> lyric-x;
    in property <float> lyric-y;
    in property <float> lyric-size: 10;
    in-out property <string> lyric-text;
    callback lyric-key(string, string);
    in property <bool> chord-dialog-shown: false;
    in-out property <string> chord-name;
    in property <[string]> chord-library;
    in property <[string]> chord-roots;
    in-out property <int> chord-root;
    in property <[string]> chord-triads;
    in-out property <int> chord-triad;
    in property <[string]> chord-extensions;
    in-out property <int> chord-extension;
    in property <[string]> chord-basses;
    in-out property <int> chord-bass;
    in property <[AltBox]> chord-alterations;
    in property <int> chord-strings: 6;
    in property <[int]> chord-dots;
    in-out property <int> chord-first-fret: 1;
    in property <int> chord-last-fret: 24;
    in property <[string]> chord-voicings;
    in property <bool> chord-show-diagram: true;
    callback chord-changed(string, int, string);
    callback chord-dialog-done(bool);
    in property <bool> paste-dialog-shown: false;
    in-out property <int> paste-times: 1;
    in-out property <bool> paste-replace: false;
    callback paste-dialog-done(bool);
    // The track dialog and Transpose… (track_form.rs).
    in property <bool> track-dialog-shown: false;
    in property <string> track-heading;
    in-out property <TrackFields> track-fields;
    in property <[string]> track-instrument-names;
    in property <[string]> track-string-counts;
    in property <[string]> track-key-names;
    in property <[string]> track-pattern-names;
    in property <string> track-preview;
    in property <bool> track-invalid;
    callback track-form-changed();
    callback track-dialog-done(bool);
    in property <bool> transpose-dialog-shown: false;
    in property <string> transpose-heading;
    in-out property <int> transpose-amount;
    in-out property <bool> transpose-steps;
    in-out property <bool> transpose-keep;
    callback transpose-dialog-done(bool);
    // A track row's right-click menu: the row and what was chosen.
    callback track-menu(int, string);
    // The page's right-click menu.
    callback page-menu(string);
    // The score's sections, for Edit → Go to Section.
    in property <[string]> sections;
    callback go-to-section(int);
    // Gives the keyboard back to the page (after a question).
    public function focus-page() { keys.focus(); }
    callback export-pdf();
    callback quit();
    callback settings-changed();
    callback canvas-changed();
    callback zoom-moved(float);
    callback standard-clicked(int);
    callback tablature-clicked(int);
    in property <image> standard-icon;
    in property <image> tablature-icon;
    in property <image> mute-icon;
    in property <image> solo-icon;
    // The mixer's controls in each track's row (greyed out until an output
    // plugin is installed; they work from M4).
    callback mixer-volume(int, float);
    callback mixer-pan(int, float);
    callback mixer-mute(int);
    callback mixer-solo(int);
    callback tool-picked(int);
    callback toolbar-activated(string);
    callback tab-clicked(int, int);
    callback open-plugin-manager();
    // The editor (editing.rs): a press on the page, in the viewport's
    // logical pixels, with Shift; a key by name, with Shift and Ctrl,
    // answering whether the editor took it.
    callback page-pressed(length, length, bool);
    callback page-double-clicked(length, length);
    // A right-click on the page, before its menu opens.
    callback page-menu-pressed(length, length);
    // The Inspector's view of the caret's bar (inspector.rs).
    in property <string> inspector-heading;
    in property <string> inspector-unit;
    in property <string> inspector-caret;
    in property <[InspectorVoice]> inspector-voices;
    in property <[InspectorField]> inspector-fields;
    // The Song tab: the score's information (M3 slice 6).
    in property <[SongField]> song-fields;
    callback song-edited(string, string);
    // The palette's search.
    in-out property <string> palette-query;
    in property <int> palette-search-requests;
    in property <[PaletteToolRow]> palette-found;
    callback palette-searched(string);
    callback inspector-changed(string, int);
    callback caret-key(string, bool, bool) -> bool;
    // Note entry: a key typed at the caret, with Shift, Ctrl and Alt,
    // answering whether it was one (editing.rs, `Editing::typed`).
    callback edit-key(string, bool, bool, bool) -> bool;
    callback undo();
    callback redo();
    callback next-bad-bar();
    callback track-selected(int);
    // Plugins' tabs (plugin_tab.slint), by area number (0 top, 1 bottom,
    // 2 left, 3 right): their rows, or a message instead; what the user does
    // to their widgets; a canvas's room.
    in property <[PluginRow]> top-plugin-rows;
    in property <string> top-plugin-message;
    in property <[PluginRow]> bottom-plugin-rows;
    in property <string> bottom-plugin-message;
    in property <[PluginRow]> left-plugin-rows;
    in property <string> left-plugin-message;
    in property <[PluginRow]> right-plugin-rows;
    in property <string> right-plugin-message;
    callback plugin-clicked(int, string);
    callback plugin-toggled(int, string, bool);
    callback plugin-slid(int, string, float);
    callback plugin-edited(int, string, string);
    callback plugin-chosen(int, string, int);
    callback plugin-pointer(int, string, int, float, float, int);
    callback plugin-canvas-room(int, string, float, float);
    callback area-toggled(int);
    callback panels-changed();

    // Choose layout n (0 Page, 1 Vertical, 2 Horizontal, 3 Parchment): only
    // its item stays ticked, even when it was clicked while already ticked.
    public function pick-layout(n: int) {
        root.layout = n;
        root.layout-0 = n == 0;
        root.layout-1 = n == 1;
        root.layout-2 = n == 2;
        root.layout-3 = n == 3;
    }
    public function pick-paper(n: int) {
        root.paper = n;
        root.paper-0 = n == 0;
        root.paper-1 = n == 1;
    }

    // Scroll the canvas by (dx, dy), within its bounds.
    public function scroll-by(dx: length, dy: length) {
        flick.viewport-x = clamp(flick.viewport-x - dx, min(0px, flick.visible-width - flick.viewport-width), 0px);
        flick.viewport-y = clamp(flick.viewport-y - dy, min(0px, flick.visible-height - flick.viewport-height), 0px);
    }
    // Put canvas pixel (x, y) at the top left of the view.
    public function scroll-to(x: length, y: length) {
        flick.viewport-x = clamp(-x, min(0px, flick.visible-width - flick.viewport-width), 0px);
        flick.viewport-y = clamp(-y, min(0px, flick.visible-height - flick.viewport-height), 0px);
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New"; shortcut: @keys(Control + N); activated => { root.new-file(); } }
            MenuItem { title: "Open…"; shortcut: @keys(Control + O); activated => { root.open-file(); } }
            MenuItem { title: "Save"; enabled: root.has-score; shortcut: @keys(Control + S); activated => { root.save(); } }
            MenuItem { title: "Save As…"; enabled: root.has-score; shortcut: @keys(Control + Shift + S); activated => { root.save-as(); } }
            MenuItem { title: "Export PDF…"; enabled: root.has-score; activated => { root.export-pdf(); } }
            Menu {
                title: "Paper Size";
                MenuItem { title: "A4"; checkable: true; checked <=> root.paper-0; activated => { root.pick-paper(0); root.settings-changed(); } }
                MenuItem { title: "Letter"; checkable: true; checked <=> root.paper-1; activated => { root.pick-paper(1); root.settings-changed(); } }
            }
            MenuSeparator { }
            MenuItem { title: "Quit"; shortcut: @keys(Control + Q); activated => { root.quit(); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: root.undo-title; enabled: root.can-undo; shortcut: @keys(Control + Z); activated => { root.undo(); } }
            MenuItem { title: root.redo-title; enabled: root.can-redo; shortcut: @keys(Control + Y); activated => { root.redo(); } }
            MenuSeparator { }
            MenuItem { title: "Select All"; enabled: root.has-score; shortcut: @keys(Control + A); activated => { root.caret-key("a", false, true); } }
            MenuSeparator { }
            MenuItem { title: "Cut (Ctrl + X)"; enabled: root.has-score; activated => { root.edit-command("cut"); } }
            MenuItem { title: "Copy (Ctrl + C)"; enabled: root.has-score; activated => { root.edit-command("copy"); } }
            MenuItem { title: "Paste (Ctrl + V)"; enabled: root.has-score; activated => { root.edit-command("paste"); } }
            MenuItem { title: "Special Paste… (Ctrl + Shift + V)"; enabled: root.has-score; activated => { root.edit-command("special-paste"); } }
            MenuSeparator { }
            Menu {
                title: "Go to Section";
                if root.sections.length == 0 : MenuItem { title: "No sections"; enabled: false; }
                for s[i] in root.sections : MenuItem { title: s; activated => { root.go-to-section(i); } }
            }
            MenuSeparator { }
            // Note entry's keys are taken on the page (editing.rs); these
            // items name them, and do the same.
            MenuItem { title: "Insert Beat (Ctrl + Insert)"; enabled: root.has-score; activated => { root.edit-command("insert-beat"); } }
            MenuItem { title: "Delete Beats (Shift + Delete)"; enabled: root.has-score; activated => { root.edit-command("delete-beats"); } }
            MenuItem { title: "Clear Beats (Ctrl + Shift + Delete)"; enabled: root.has-score; activated => { root.edit-command("clear-beats"); } }
            MenuItem { title: "Clear Bar"; enabled: root.has-score; activated => { root.edit-command("clear-bar"); } }
            MenuItem { title: "Move Beat Left"; enabled: root.has-score; activated => { root.edit-command("move-left"); } }
            MenuItem { title: "Move Beat Right"; enabled: root.has-score; activated => { root.edit-command("move-right"); } }
            Menu {
                title: "Move Beat to Voice";
                MenuItem { title: "Voice 1 (Alt + 1)"; enabled: root.has-score; activated => { root.edit-command("voice-1"); } }
                MenuItem { title: "Voice 2 (Alt + 2)"; enabled: root.has-score; activated => { root.edit-command("voice-2"); } }
                MenuItem { title: "Voice 3 (Alt + 3)"; enabled: root.has-score; activated => { root.edit-command("voice-3"); } }
                MenuItem { title: "Voice 4 (Alt + 4)"; enabled: root.has-score; activated => { root.edit-command("voice-4"); } }
            }
            MenuItem { title: "Remove Unused Voices"; enabled: root.has-score; activated => { root.edit-command("remove-unused-voices"); } }
            MenuSeparator { }
            MenuItem { title: "Insert Bar (Insert)"; enabled: root.has-score; activated => { root.edit-command("insert-bar"); } }
            MenuItem { title: "Delete Bars (Ctrl + Delete)"; enabled: root.has-score; activated => { root.edit-command("delete-bars"); } }
            MenuItem { title: "Bar… (Ctrl + K)"; enabled: root.has-score; activated => { root.edit-command("bar-dialog"); } }
            MenuItem { title: "Custom N-tuplet…"; enabled: root.has-score; activated => { root.edit-command("tuplet-dialog"); } }
            MenuItem { title: "Chord… (A)"; enabled: root.has-score; activated => { root.edit-command("chord-dialog"); } }
            MenuItem { title: "Text… (Shift + T)"; enabled: root.has-score; activated => { root.edit-command("text-dialog"); } }
            MenuItem { title: "Type Lyrics (Ctrl + T)"; enabled: root.has-score; activated => { root.edit-command("lyrics"); } }
            MenuSeparator { }
            MenuItem { title: "Track Properties…"; enabled: root.has-score; activated => { root.edit-command("track-properties"); } }
            MenuItem { title: "Add Track"; enabled: root.has-score; activated => { root.edit-command("add-track"); } }
            MenuItem { title: "Delete Track…"; enabled: root.has-score && root.tracks.length > 1; activated => { root.edit-command("delete-track"); } }
            MenuItem { title: "Transpose Selection…"; enabled: root.has-score; activated => { root.edit-command("transpose-selection"); } }
        }
        Menu {
            title: "View";
            // Staff layouts (VIEW-3), as in Guitar Pro.
            Menu {
                title: "Layout";
                MenuItem { title: "Page"; checkable: true; checked <=> root.layout-0; activated => { root.pick-layout(0); root.settings-changed(); } }
                MenuItem { title: "Vertical"; checkable: true; checked <=> root.layout-1; activated => { root.pick-layout(1); root.settings-changed(); } }
                MenuItem { title: "Horizontal"; checkable: true; checked <=> root.layout-2; activated => { root.pick-layout(2); root.settings-changed(); } }
                MenuItem { title: "Parchment"; checkable: true; checked <=> root.layout-3; activated => { root.pick-layout(3); root.settings-changed(); } }
            }
            MenuSeparator { }
            MenuItem { title: "Dark Interface"; checkable: true; checked <=> root.dark-interface; activated => { root.settings-changed(); } }
            MenuItem { title: "Dark Page"; checkable: true; checked <=> root.dark-page; activated => { root.settings-changed(); } }
            MenuItem { title: "Dynamics"; checkable: true; checked <=> root.dynamics; activated => { root.settings-changed(); } }
            MenuSeparator { }
            MenuItem { title: "Toolbar"; checkable: true; checked <=> root.toolbar-shown; }
            Menu {
                title: "Panels";
                MenuItem { title: "Top"; checkable: true; checked <=> root.top-shown; activated => { root.panels-changed(); } }
                MenuItem { title: "Bottom"; checkable: true; checked <=> root.bottom-shown; shortcut: @keys(F8); activated => { root.panels-changed(); } }
                MenuItem { title: "Left"; checkable: true; checked <=> root.left-shown; shortcut: @keys(F7); activated => { root.panels-changed(); } }
                MenuItem { title: "Right"; checkable: true; checked <=> root.right-shown; activated => { root.panels-changed(); } }
            }
        }
        Menu {
            title: "Tools";
            for tool[i] in root.tools : MenuItem {
                title: tool.title;
                enabled: root.has-score && tool.enabled;
                activated => { root.tool-picked(i); }
            }
            MenuSeparator {}
            // Guitar Pro 8's "Check bar duration" key.
            MenuItem { title: "Next Bar That Doesn't Add Up"; enabled: root.bad-bars; shortcut: @keys(F4); activated => { root.next-bad-bar(); } }
            MenuItem { title: "Transpose…"; enabled: root.has-score; activated => { root.edit-command("transpose-all"); } }
            MenuSeparator {}
            MenuItem { title: "Plugins…"; activated => { root.open-plugin-manager(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "Keyboard and Mouse"; shortcut: @keys(F1); activated => { shortcuts-popup.show(); } }
            MenuItem { title: "About OxiGuitar"; activated => { about-popup.show(); } }
        }
    }

    shortcuts-popup := InfoPopup {
        x: (root.width - self.width) / 2;
        y: 60px;
        heading: "Keyboard and mouse";
        lines: root.shortcut-lines;
    }
    about-popup := InfoPopup {
        x: (root.width - self.width) / 2;
        y: 60px;
        heading: "OxiGuitar";
        lines: root.about-lines;
        // A click on the button must reach it; a click outside closes.
        close-policy: PopupClosePolicy.close-on-click-outside;
        // Donations (Mateus, 25 Oct 2026; the README's "Buy me a drink").
        Rectangle { height: 1px; background: Palette.border; }
        Text {
            text: "OxiGuitar is free. If it's useful to you, buy Mateus a drink, or chip in for the tokens that build it.";
            font-size: 12px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            // The QR code is black on transparent: on white, so it shows in the dark interface too.
            Rectangle {
                width: 104px;
                height: 104px;
                background: white;
                border-radius: 4px;
                Image { source: @image-url("../../../assets/DonationQRCode.png"); width: 96px; height: 96px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Button {
                    text: "Donate with PayPal";
                    clicked => {
                        root.open-donation();
                        about-popup.close();
                    }
                }
                Text { text: "or scan the code with your phone"; font-size: 11px; opacity: 0.7; }
            }
        }
    }

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            // The editor's keys first (editing.rs): the caret and the
            // selection, as Guitar Pro 8 moves its cursor.
            let name = event.text == Key.LeftArrow ? "left"
                : event.text == Key.RightArrow ? "right"
                : event.text == Key.UpArrow ? "up"
                : event.text == Key.DownArrow ? "down"
                : event.text == Key.Home ? "home"
                : event.text == Key.End ? "end"
                : event.text == Key.Tab ? "tab"
                : event.text == Key.Backtab ? "backtab"
                : event.text == Key.Escape ? "escape"
                : event.text == Key.Backspace ? "backspace"
                : event.text == Key.Delete ? "delete"
                : event.text == Key.Insert ? "insert"
                : event.text;
            if (event.text == Key.Escape) {
                // Closes the Help popups (a click anywhere does too).
                shortcuts-popup.close();
                about-popup.close();
            }
            if (root.has-score && !event.modifiers.alt && root.caret-key(name, event.modifiers.shift, event.modifiers.control)) {
                return accept;
            }
            if (root.has-score && root.edit-key(name, event.modifiers.shift, event.modifiers.control, event.modifiers.alt)) {
                return accept;
            }
            if (event.modifiers.control || event.modifiers.alt || event.text == Key.Escape) {
                return reject;
            }
            if (event.text == Key.PageDown || event.text == " ") {
                root.scroll-by(0, flick.visible-height * 0.9);
            } else if (event.text == Key.PageUp) {
                root.scroll-by(0, -flick.visible-height * 0.9);
            } else if (event.text == Key.DownArrow) {
                root.scroll-by(0, 40px);
            } else if (event.text == Key.UpArrow) {
                root.scroll-by(0, -40px);
            } else if (event.text == Key.RightArrow) {
                root.scroll-by(40px, 0);
            } else if (event.text == Key.LeftArrow) {
                root.scroll-by(-40px, 0);
            } else if (event.text == Key.Home) {
                root.scroll-to(0, 0);
            } else if (event.text == Key.End) {
                root.scroll-to(flick.viewport-width, flick.viewport-height);
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            // The toolbar: the core's sections, then plugins' sections.
            if root.toolbar-shown : Rectangle {
                height: 36px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: start;
                    for section[s] in root.toolbar : HorizontalLayout {
                        spacing: 2px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        if s > 0 : Rectangle {
                            width: 9px;
                            Rectangle { x: 4px; width: 1px; height: 70%; background: Palette.border; }
                        }
                        for item in section.items : IconButton {
                            icon: item.icon;
                            tip: item.tip;
                            enabled: item.enabled && (item.id != "export-pdf" || root.has-score);
                            checked: item.checkable && item.checked;
                            clicked => { root.toolbar-activated(item.id); }
                        }
                    }
                }
            }
            if root.toolbar-shown : Rectangle { height: 1px; background: Palette.border; }

            // Top area: the player, then plugins' tabs.
            if root.top-shown : TabStrip {
                state: root.top-area;
                chevron-open: @image-url("../../../assets/icons/ui/chevron-up.svg");
                chevron-closed: @image-url("../../../assets/icons/ui/chevron-down.svg");
                tab-clicked(i) => { root.tab-clicked(0, i); }
                chevron-clicked => { root.area-toggled(0); }
            }
            if root.top-shown && !root.top-area.collapsed : Rectangle {
                height: root.top-height;
                background: Palette.alternate-background;
                if root.top-area.active-id == "player" : HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: start;
                    // Transport: rewind, play, play the selection, pause, stop.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton { icon: @image-url("../../../assets/icons/ui/rewind.svg"); tip: "Rewind"; enabled: root.player-available; }
                            IconButton { icon: @image-url("../../../assets/icons/ui/play.svg"); tip: "Play"; enabled: root.player-available; }
                            IconButton { icon: @image-url("../../../assets/icons/ui/play-selection.svg"); tip: "Play Selection"; enabled: root.player-available; }
                            IconButton { icon: @image-url("../../../assets/icons/ui/pause.svg"); tip: "Pause"; enabled: root.player-available; }
                            IconButton { icon: @image-url("../../../assets/icons/ui/stop.svg"); tip: "Stop"; enabled: root.player-available; }
                        }
                    }
                    Rectangle { width: 13px; Rectangle { x: 6px; width: 1px; height: 60%; background: Palette.border; } }
                    // Practice: count-in, loop, metronome.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton { icon: @image-url("../../../assets/icons/ui/count-in.svg"); tip: "Count-In"; enabled: root.player-available; }
                            IconButton { icon: @image-url("../../../assets/icons/ui/loop.svg"); tip: "Loop"; enabled: root.player-available; }
                            IconButton { icon: @image-url("../../../assets/icons/ui/metronome.svg"); tip: "Metronome"; enabled: root.player-available; }
                        }
                    }
                    Rectangle { width: 13px; Rectangle { x: 6px; width: 1px; height: 60%; background: Palette.border; } }
                    // Which output plugin plays the score.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "Output";
                                font-size: 12px;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(root.player-available ? 0.2 : 0.6);
                            }
                            ComboBox {
                                width: 200px;
                                enabled: root.player-available;
                                model: root.outputs;
                            }
                        }
                    }
                }
                if root.top-area.plugin : PluginTab {
                    rows: root.top-plugin-rows;
                    message: root.top-plugin-message;
                    clicked(id) => { root.plugin-clicked(0, id); }
                    toggled(id, on) => { root.plugin-toggled(0, id, on); }
                    slid(id, v) => { root.plugin-slid(0, id, v); }
                    edited(id, text) => { root.plugin-edited(0, id, text); }
                    chosen(id, i) => { root.plugin-chosen(0, id, i); }
                    pointer(id, k, x, y, b) => { root.plugin-pointer(0, id, k, x, y, b); }
                    canvas-room(id, w, h) => { root.plugin-canvas-room(0, id, w / 1px, h / 1px); }
                }
            }
            if root.top-shown && !root.top-area.collapsed : Splitter {
                dragged(d) => { root.top-height = clamp(root.top-height + d, 36px, 300px); }
            }

            HorizontalLayout {
                // Left area: the palette (greyed out until M3), then plugins' tabs.
                if root.left-shown && root.left-area.collapsed : SideStrip {
                    chevron: @image-url("../../../assets/icons/ui/chevron-right.svg");
                    tip: "Expand";
                    clicked => { root.area-toggled(2); }
                }
                if root.left-shown && !root.left-area.collapsed : VerticalLayout {
                    width: root.left-width;
                    TabStrip {
                        state: root.left-area;
                        chevron-open: @image-url("../../../assets/icons/ui/chevron-left.svg");
                        chevron-closed: @image-url("../../../assets/icons/ui/chevron-right.svg");
                        tab-clicked(i) => { root.tab-clicked(2, i); }
                        chevron-clicked => { root.area-toggled(2); }
                    }
                    Rectangle {
                        background: Palette.alternate-background;
                        if root.left-area.active-id == "palette" : VerticalLayout {
                          PaletteSearch {
                            query <=> root.palette-query;
                            focus-requests: root.palette-search-requests;
                            searched(q) => { root.palette-searched(q); }
                            done(clear) => {
                                if (clear) {
                                    root.palette-query = "";
                                    root.palette-searched("");
                                }
                                root.focus-page();
                            }
                          }
                          PaletteView {
                            groups: root.palette-groups;
                            searching: root.palette-query != "";
                            found: root.palette-found;
                            chevron-open: @image-url("../../../assets/icons/ui/chevron-down.svg");
                            chevron-closed: @image-url("../../../assets/icons/ui/chevron-right.svg");
                            group-clicked(g) => { root.palette-group-clicked(g); }
                            tool-clicked(id) => { root.palette-tool-clicked(id); }
                          }
                        }
                        if root.left-area.plugin : PluginTab {
                    rows: root.left-plugin-rows;
                    message: root.left-plugin-message;
                    clicked(id) => { root.plugin-clicked(2, id); }
                    toggled(id, on) => { root.plugin-toggled(2, id, on); }
                    slid(id, v) => { root.plugin-slid(2, id, v); }
                    edited(id, text) => { root.plugin-edited(2, id, text); }
                    chosen(id, i) => { root.plugin-chosen(2, id, i); }
                    pointer(id, k, x, y, b) => { root.plugin-pointer(2, id, k, x, y, b); }
                    canvas-room(id, w, h) => { root.plugin-canvas-room(2, id, w / 1px, h / 1px); }
                }
                    }
                }
                if root.left-shown && !root.left-area.collapsed : SideSplitter {
                    dragged(d) => { root.left-width = clamp(root.left-width + d, 120px, 500px); }
                }

                // The page: tiles drawn by the worker thread, on the dark
                // canvas whatever the page colour.
                canvas := Rectangle {
                    background: Look.canvas;
                    clip: true;
                    flick := ScrollView {
                        viewport-width: max(self.visible-width, root.content-width + 48px);
                        viewport-height: max(self.visible-height, root.content-height + 48px);
                        changed viewport-x => { root.canvas-changed(); }
                        changed viewport-y => { root.canvas-changed(); }
                        changed visible-width => { root.canvas-changed(); }
                        changed visible-height => { root.canvas-changed(); }
                        for t in root.old-tiles : Image {
                            x: root.origin-x + t.x;
                            y: root.origin-y + t.y;
                            width: t.size;
                            height: t.size;
                            source: t.image;
                        }
                        for t in root.tiles : Image {
                            x: root.origin-x + root.snap-x + t.x;
                            y: root.origin-y + root.snap-y + t.y;
                            width: t.size;
                            height: t.size;
                            source: t.image;
                            image-rendering: pixelated;
                        }
                        // A press puts the caret there (main.rs, page_pressed).
                        TouchArea {
                            x: 0;
                            y: 0;
                            width: flick.viewport-width;
                            height: flick.viewport-height;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    keys.focus();
                                    root.page-pressed(self.mouse-x, self.mouse-y, e.modifiers.shift);
                                }
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    keys.focus();
                                    root.page-menu-pressed(self.mouse-x, self.mouse-y);
                                    page-menu-area.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                            // On a time signature: the Bar dialog for its bar.
                            double-clicked => { root.page-double-clicked(self.mouse-x, self.mouse-y); }
                        }
                        // Right-click on the page: the selection's commands. The
                        // TouchArea above opens it once the caret has moved.
                        page-menu-area := ContextMenuArea {
                            enabled: false;
                            x: 0;
                            y: 0;
                            width: flick.viewport-width;
                            height: flick.viewport-height;
                            Menu {
                                MenuItem { title: "Transpose…"; activated => { root.page-menu("transpose"); } }
                                MenuItem { title: "Bar…"; activated => { root.page-menu("bar"); } }
                                MenuItem { title: "Track Properties…"; activated => { root.page-menu("track"); } }
                                MenuSeparator { }
                                MenuItem { title: "Cut"; activated => { root.page-menu("cut"); } }
                                MenuItem { title: "Copy"; activated => { root.page-menu("copy"); } }
                                MenuItem { title: "Paste"; activated => { root.page-menu("paste"); } }
                            }
                        }
                        // The selection and the caret, over the tiles: moving
                        // them redraws no tile.
                        for b in root.selection-boxes : Rectangle {
                            x: root.origin-x + b.x * root.pt-scale * 1px;
                            y: root.origin-y + b.y * root.pt-scale * 1px;
                            width: b.w * root.pt-scale * 1px;
                            height: b.h * root.pt-scale * 1px;
                            background: Look.accent.transparentize(0.8);
                        }
                        if root.caret-shown : Rectangle {
                            x: root.origin-x + root.caret.x * root.pt-scale * 1px;
                            y: root.origin-y + root.caret.y * root.pt-scale * 1px;
                            width: root.caret.w * root.pt-scale * 1px;
                            height: root.caret.h * root.pt-scale * 1px;
                            background: Look.accent.transparentize(0.88);
                            border-color: Look.accent.transparentize(0.4);
                            border-width: 1px;
                            border-radius: 2px;
                        }
                        if root.string-shown : Rectangle {
                            x: root.origin-x + root.caret-string.x * root.pt-scale * 1px;
                            y: root.origin-y + root.caret-string.y * root.pt-scale * 1px;
                            width: root.caret-string.w * root.pt-scale * 1px;
                            height: root.caret-string.h * root.pt-scale * 1px;
                            border-color: Look.accent;
                            border-width: 1.5px;
                            border-radius: 2px;
                        }
                        // Lyrics typed on the page (M3 slice 6, as in
                        // MuseScore): space and hyphen go to the next beat.
                        if root.lyric-shown : lyric-box := Rectangle {
                            property <length> size: root.lyric-size * root.pt-scale * 1px;
                            x: root.origin-x + root.lyric-x * root.pt-scale * 1px - self.width / 2;
                            y: root.origin-y + root.lyric-y * root.pt-scale * 1px - self.size * 1.1;
                            width: max(lyric-input.preferred-width + 10px, 3 * self.size);
                            height: self.size * 1.5;
                            background: root.dark-page ? #1e1f22 : #ffffff;
                            border-color: Look.accent;
                            border-width: 1px;
                            border-radius: 2px;
                            FocusScope {
                                capture-key-pressed(event) => {
                                    if (event.text == " ") {
                                        root.lyric-key("space", lyric-input.text);
                                        return accept;
                                    }
                                    if (event.text == "-") {
                                        root.lyric-key("hyphen", lyric-input.text);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.lyric-key("up", lyric-input.text);
                                        return accept;
                                    }
                                    if (event.text == Key.DownArrow) {
                                        root.lyric-key("down", lyric-input.text);
                                        return accept;
                                    }
                                    if (event.text == Key.Backspace && lyric-input.text == "") {
                                        root.lyric-key("back", "");
                                        return accept;
                                    }
                                    if (event.text == Key.Escape || event.text == Key.Return) {
                                        root.lyric-key("done", lyric-input.text);
                                        return accept;
                                    }
                                    reject
                                }
                                lyric-input := TextInput {
                                    x: 5px;
                                    width: lyric-box.width - 10px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    text <=> root.lyric-text;
                                    font-size: lyric-box.size;
                                    color: root.dark-page ? #e6e6e6 : #1a1a1a;
                                    single-line: true;
                                    init => {
                                        self.focus();
                                        self.set-selection-offsets(0, 999);
                                    }
                                }
                            }
                        }
                    }

                    if !root.has-score : Text {
                        text: "File → Open (Ctrl + O) to open a Guitar Pro file";
                        font-size: 14px;
                        color: Look.on-canvas;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Score zoom, bottom right: 25 % to 400 % on a logarithmic
                    // scale, so 100 % sits in the middle. Clicking the
                    // percentage resets it to 100 %. The mouse wheel over the
                    // page zooms too (main.rs).
                    Pill {
                        width: 168px;
                        x: parent.width - self.width - 10px;
                        y: parent.height - self.height - 10px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 4px;
                            Text {
                                text: root.zoom-text;
                                font-size: 11px;
                                width: 38px;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(0.2);
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.zoom-log = 0; root.zoom-moved(0); }
                                }
                            }
                            Slider {
                                minimum: -2;
                                maximum: 2;
                                step: 0.01;
                                value <=> root.zoom-log;
                                changed(v) => { root.zoom-moved(v); }
                            }
                        }
                    }
                }

                // Right area: the inspector (M3), then plugins' tabs.
                if root.right-shown && !root.right-area.collapsed : SideSplitter {
                    dragged(d) => { root.right-width = clamp(root.right-width - d, 120px, 500px); }
                }
                if root.right-shown && !root.right-area.collapsed : VerticalLayout {
                    width: root.right-width;
                    TabStrip {
                        state: root.right-area;
                        chevron-open: @image-url("../../../assets/icons/ui/chevron-right.svg");
                        chevron-closed: @image-url("../../../assets/icons/ui/chevron-left.svg");
                        tab-clicked(i) => { root.tab-clicked(3, i); }
                        chevron-clicked => { root.area-toggled(3); }
                    }
                    Rectangle {
                        background: Palette.alternate-background;
                        if root.right-area.active-id == "inspector" && !root.has-score : Placeholder { text: "Open a file or start a new one: the caret's bar shows here, with each voice's beats."; }
                        if root.right-area.active-id == "inspector" && root.has-score : Inspector {
                            heading: root.inspector-heading;
                            unit: root.inspector-unit;
                            caret: root.inspector-caret;
                            voices: root.inspector-voices;
                            fields: root.inspector-fields;
                            field-changed(id, v) => { root.inspector-changed(id, v); }
                        }
                        if root.right-area.active-id == "song" && !root.has-score : Placeholder { text: "Open a file or start a new one: its title, artist and the rest show here."; }
                        if root.right-area.active-id == "song" && root.has-score : SongView {
                            fields: root.song-fields;
                            edited(id, text) => { root.song-edited(id, text); }
                        }
                        if root.right-area.plugin : PluginTab {
                    rows: root.right-plugin-rows;
                    message: root.right-plugin-message;
                    clicked(id) => { root.plugin-clicked(3, id); }
                    toggled(id, on) => { root.plugin-toggled(3, id, on); }
                    slid(id, v) => { root.plugin-slid(3, id, v); }
                    edited(id, text) => { root.plugin-edited(3, id, text); }
                    chosen(id, i) => { root.plugin-chosen(3, id, i); }
                    pointer(id, k, x, y, b) => { root.plugin-pointer(3, id, k, x, y, b); }
                    canvas-room(id, w, h) => { root.plugin-canvas-room(3, id, w / 1px, h / 1px); }
                }
                    }
                }
                if root.right-shown && root.right-area.collapsed : SideStrip {
                    chevron: @image-url("../../../assets/icons/ui/chevron-left.svg");
                    tip: "Expand";
                    clicked => { root.area-toggled(3); }
                }
            }

            // Bottom area: the track list with each track's mixer, then plugins' tabs.
            if root.bottom-shown && !root.bottom-area.collapsed : Splitter {
                dragged(d) => { root.bottom-height = clamp(root.bottom-height - d, 48px, 400px); }
            }
            if root.bottom-shown : TabStrip {
                state: root.bottom-area;
                chevron-open: @image-url("../../../assets/icons/ui/chevron-down.svg");
                chevron-closed: @image-url("../../../assets/icons/ui/chevron-up.svg");
                tab-clicked(i) => { root.tab-clicked(1, i); }
                chevron-clicked => { root.area-toggled(1); }
            }
            if root.bottom-shown && !root.bottom-area.collapsed : Rectangle {
                height: root.bottom-height;
                background: Palette.alternate-background;
                if root.bottom-area.active-id == "tracks" && !root.has-score : Placeholder { text: "The tracks of the open score appear here."; }
                // Track list: each track's notation buttons show it (both
                // off hides it); a click on a name selects the track for the
                // editor (Mateus, 19 Oct 2026). No show tick: the buttons do
                // that (Mateus, 17 Oct 2026).
                if root.bottom-area.active-id == "tracks" && root.has-score : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding-top: 4px;
                        // Each row (Mateus, 19 Oct 2026): the name, the
                        // mixer (mute, solo, volume, pan; greyed out until
                        // an output plugin is installed), then tablature
                        // and standard notation, in any combination; both
                        // off hides the track; then the track across the
                        // song, with the playback position.
                        for track[i] in root.tracks : HorizontalLayout {
                            padding-left: 10px;
                            spacing: 8px;
                            height: 28px;
                            Rectangle {
                                width: 200px;
                                border-radius: 3px;
                                background: i == root.selected-track ? Look.accent.transparentize(0.75) : transparent;
                                Text {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    text: track.name;
                                    font-size: 12px;
                                    font-weight: track.shown ? 600 : 400;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.track-selected(i); }
                                }
                                // Right-click: the track's own commands
                                // (docs/design/ui.md, "The track dialog").
                                ContextMenuArea {
                                    Menu {
                                        MenuItem { title: "Properties…"; activated => { root.track-menu(i, "properties"); } }
                                        MenuItem { title: "Transpose…"; activated => { root.track-menu(i, "transpose"); } }
                                        MenuSeparator { }
                                        MenuItem { title: "Add Track"; activated => { root.track-menu(i, "add"); } }
                                        MenuItem { title: "Duplicate"; activated => { root.track-menu(i, "duplicate"); } }
                                        MenuItem { title: "Move Up"; enabled: i > 0; activated => { root.track-menu(i, "up"); } }
                                        MenuItem { title: "Move Down"; enabled: i < root.tracks.length - 1; activated => { root.track-menu(i, "down"); } }
                                        MenuSeparator { }
                                        MenuItem { title: "Delete…"; enabled: root.tracks.length > 1; activated => { root.track-menu(i, "delete"); } }
                                    }
                                }
                            }
                            NotationButton {
                                icon: root.mute-icon;
                                on: track.mute;
                                enabled: root.player-available;
                                tip: root.player-available ? "Mute" : "Mute (comes with the player)";
                                clicked => { root.mixer-mute(i); }
                            }
                            NotationButton {
                                icon: root.solo-icon;
                                on: track.solo;
                                enabled: root.player-available;
                                tip: root.player-available ? "Solo" : "Solo (comes with the player)";
                                clicked => { root.mixer-solo(i); }
                            }
                            Rectangle {
                                width: 96px;
                                Slider {
                                    width: parent.width;
                                    height: parent.height;
                                    minimum: 0;
                                    maximum: 1;
                                    step: 0.01;
                                    value: track.volume;
                                    enabled: root.player-available;
                                    changed(v) => { root.mixer-volume(i, v); }
                                }
                                Tooltip { text: @markdown("\{root.player-available ? "Volume" : "Volume (comes with the player)"}"); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Knob {
                                    value: track.pan;
                                    enabled: root.player-available;
                                    tip: root.player-available ? "Pan" : "Pan (comes with the player)";
                                    changed(v) => { root.mixer-pan(i, v); }
                                }
                            }
                            Rectangle { width: 6px; }
                            // Tracks without strings have no tablature; the
                            // empty slot keeps the clefs in one column.
                            Rectangle {
                                width: 28px;
                                if track.can-tab : NotationButton {
                                    icon: root.tablature-icon;
                                    on: track.tablature;
                                    tip: "Tablature";
                                    clicked => { root.tablature-clicked(i); }
                                }
                            }
                            NotationButton {
                                icon: root.standard-icon;
                                on: track.standard;
                                tip: "Standard notation";
                                clicked => { root.standard-clicked(i); }
                            }
                            // The track across the song, to the row's end.
                            Rectangle { width: 6px; }
                            TrackOverview {
                                min-width: 80px;
                                horizontal-stretch: 1;
                                wave: track.wave;
                                bars: track.bars;
                                shown: track.shown;
                                position: root.song-position;
                            }
                            Rectangle { width: 2px; }
                        }
                    }
                }
                if root.bottom-area.plugin : PluginTab {
                    rows: root.bottom-plugin-rows;
                    message: root.bottom-plugin-message;
                    clicked(id) => { root.plugin-clicked(1, id); }
                    toggled(id, on) => { root.plugin-toggled(1, id, on); }
                    slid(id, v) => { root.plugin-slid(1, id, v); }
                    edited(id, text) => { root.plugin-edited(1, id, text); }
                    chosen(id, i) => { root.plugin-chosen(1, id, i); }
                    pointer(id, k, x, y, b) => { root.plugin-pointer(1, id, k, x, y, b); }
                    canvas-room(id, w, h) => { root.plugin-canvas-room(1, id, w / 1px, h / 1px); }
                }
            }

            // Footer: the latest message on one line; a click expands the
            // whole list for this session, newest first.
            Rectangle { height: 1px; background: Palette.border; }
            Rectangle {
                height: root.footer-expanded ? 160px : 24px;
                background: Palette.alternate-background;
                if !root.footer-expanded : HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    if root.footer-count > 0 : VerticalLayout {
                        alignment: center;
                        LevelDot { level: root.footer-level; }
                    }
                    Text {
                        text: root.footer-text;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        color: Palette.foreground.transparentize(0.15);
                    }
                    if root.footer-count > 1 : Text {
                        text: root.footer-count + " messages";
                        font-size: 11px;
                        vertical-alignment: center;
                        color: Palette.foreground.transparentize(0.5);
                    }
                }
                if root.footer-expanded : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 6px;
                        padding-left: 10px;
                        spacing: 4px;
                        for row in root.footer-rows : HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 5px;
                                LevelDot { level: row.level; }
                            }
                            Text {
                                text: row.text;
                                font-size: 12px;
                                wrap: word-wrap;
                                color: Palette.foreground.transparentize(0.15);
                            }
                        }
                    }
                }
                // Collapsed: the whole line is the button. Expanded: the
                // chevron in the corner, so the list's scroll bar works.
                if !root.footer-expanded : TouchArea {
                    clicked => { root.footer-expanded = true; }
                }
                if root.footer-expanded : IconButton {
                    x: parent.width - self.width - 18px;
                    y: 4px;
                    width: 24px;
                    height: 24px;
                    icon: @image-url("../../../assets/icons/ui/chevron-down.svg");
                    tip: "Collapse";
                    clicked => { root.footer-expanded = false; }
                }
            }
        }
    }

    if root.bar-dialog-shown : BarDialog {
        width: root.width;
        height: root.height;
        fields <=> root.bar-fields;
        endings: root.bar-endings;
        directions: root.bar-directions;
        key-names: root.bar-key-names;
        clef-names: root.bar-clef-names;
        feel-names: root.bar-feel-names;
        direction-names: root.bar-direction-names;
        heading: root.bar-heading;
        done(ok) => { root.bar-dialog-done(ok); }
    }

    if root.tuplet-dialog-shown : TupletDialog {
        width: root.width;
        height: root.height;
        notes <=> root.tuplet-notes;
        in-time-of <=> root.tuplet-in-time-of;
        usual(n) => { return root.tuplet-usual(n); }
        done(ok) => { root.tuplet-dialog-done(ok); }
    }

    if root.bend-dialog-shown : BendDialog {
        width: root.width;
        height: root.height;
        heading: root.bend-heading;
        types: root.bend-types;
        amounts: root.bend-amounts;
        kind <=> root.bend-kind;
        amount <=> root.bend-amount;
        low: root.bend-low;
        high: root.bend-high;
        points: root.bend-points;
        path: root.bend-path;
        kind-picked(i) => { root.bend-kind-picked(i); }
        amount-picked(i) => { root.bend-amount-picked(i); }
        pressed(c, r) => { root.bend-pressed(c, r); }
        dragged(c, r) => { root.bend-dragged(c, r); }
        released => { root.bend-released(); }
        done(ok) => { root.bend-dialog-done(ok); }
    }

    if root.text-dialog-shown : TextDialog {
        width: root.width;
        height: root.height;
        text <=> root.text-dialog-text;
        done(ok) => { root.text-dialog-done(ok); }
    }

    if root.chord-dialog-shown : ChordDialog {
        width: root.width;
        height: root.height;
        name <=> root.chord-name;
        library: root.chord-library;
        roots: root.chord-roots;
        root-index <=> root.chord-root;
        triads: root.chord-triads;
        triad-index <=> root.chord-triad;
        extensions: root.chord-extensions;
        extension-index <=> root.chord-extension;
        basses: root.chord-basses;
        bass-index <=> root.chord-bass;
        alterations: root.chord-alterations;
        strings: root.chord-strings;
        dots: root.chord-dots;
        first-fret <=> root.chord-first-fret;
        last-fret: root.chord-last-fret;
        voicings: root.chord-voicings;
        show-diagram: root.chord-show-diagram;
        name-typed(t) => { root.chord-changed("name", 0, t); }
        library-picked(i) => { root.chord-changed("library", i, ""); }
        root-picked(i) => { root.chord-changed("root", i, ""); }
        triad-picked(i) => { root.chord-changed("triad", i, ""); }
        extension-picked(i) => { root.chord-changed("extension", i, ""); }
        bass-picked(i) => { root.chord-changed("bass", i, ""); }
        alteration-toggled(i, on) => { root.chord-changed(on ? "alt-on" : "alt-off", i, ""); }
        grid-clicked(string, row) => { root.chord-changed("grid", string * 100 + row, ""); }
        head-clicked(i) => { root.chord-changed("head", i, ""); }
        scrolled(v) => { root.chord-changed("first", v, ""); }
        voicing-picked(i) => { root.chord-changed("voicing", i, ""); }
        show-toggled(on) => { root.chord-changed("show", on ? 1 : 0, ""); }
        remove => { root.chord-changed("remove", 0, ""); }
        done(ok) => { root.chord-dialog-done(ok); }
    }

    if root.paste-dialog-shown : PasteDialog {
        width: root.width;
        height: root.height;
        times <=> root.paste-times;
        replace <=> root.paste-replace;
        done(ok) => { root.paste-dialog-done(ok); }
    }

    if root.track-dialog-shown : TrackDialog {
        width: root.width;
        height: root.height;
        heading: root.track-heading;
        fields <=> root.track-fields;
        instrument-names: root.track-instrument-names;
        string-counts: root.track-string-counts;
        key-names: root.track-key-names;
        pattern-names: root.track-pattern-names;
        preview: root.track-preview;
        invalid: root.track-invalid;
        changed => { root.track-form-changed(); }
        done(ok) => { root.track-dialog-done(ok); }
    }

    if root.transpose-dialog-shown : TransposeDialog {
        width: root.width;
        height: root.height;
        heading: root.transpose-heading;
        amount <=> root.transpose-amount;
        steps <=> root.transpose-steps;
        keep-fingering <=> root.transpose-keep;
        done(ok) => { root.transpose-dialog-done(ok); }
    }

    if root.question-shown : Question {
        width: root.width;
        height: root.height;
        heading: root.question-heading;
        lines: root.question-lines;
        buttons: root.question-buttons;
        answered(i) => { root.question-answered(i); }
    }
}
