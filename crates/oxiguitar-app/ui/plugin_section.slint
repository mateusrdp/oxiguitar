// What the window keeps of plugins' UI that isn't their own: a plugin's UI
// is its own `.slint` file (plugin interface 2.0, plugin_ui.rs), and the
// window only places it.

// A plugin's link was clicked (interface 1.4): main.rs opens its address
// in the browser, `https://` only (links.rs), for whichever window shows it.
export global PluginLinks {
    callback open(string);
}

// A plugin's section of the Track tab (interface 1.3): its heading and
// its plugin's own view, made by `factory`. A section of a plugin with
// effects for the track can move up or down, which changes the order the
// effects run in (#152).
export struct PluginSection {
    title: string,
    up: bool,
    down: bool,
    factory: component-factory,
}
