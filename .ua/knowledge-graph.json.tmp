      "id": "file:scripts/package/licenses.sh",
      "type": "file",
      "name": "licenses.sh",
      "summary": "Generates dist/THIRD-PARTY-LICENSES.html using cargo-about for all crates in the workspace (desktop app, CLI, and plugin targets). Then runs an embedded Python script that collects NOTICE files from all used crates across 6 target triples and appends them before </body>.",
      "tags": [
        "script",
        "licenses",
        "copyright",
        "distribution"
      ],
      "complexity": "moderate",
      "filePath": "scripts/package/licenses.sh"
    },
    {
      "id": "function:scripts/package/licenses.sh:generate_html",
      "type": "function",
      "name": "generate_html",
      "summary": "Runs cargo about generate --locked --workspace with licenses.hbs template to produce the base THIRD-PARTY-LICENSES.html, then invokes an embedded Python script to append NOTICE files from all used crates across all 6 target triples.",
      "tags": [
        "script",
        "licenses"
      ],
      "complexity": "moderate",
      "filePath": "scripts/package/licenses.sh"
    },
    {
      "id": "file:scripts/package/lintian.sh",
      "type": "file",
      "name": "lintian.sh",
      "summary": "Runs Lintian (Debian's package checker) on .deb, .dsc, or .changes files. Uses --fail-on none so exit status only indicates whether lintian ran, then filters output for errors and warnings not in the --allow allowlist. Reports failing findings as GitHub Actions annotations when GITHUB_ACTIONS is set.",
      "tags": [
        "script",
        "lintian",
        "debian",
        "validation",
        "CI"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/lintian.sh"
    },
    {
      "id": "function:scripts/package/lintian.sh:run_lintian",
      "type": "function",
      "name": "run_lintian",
      "summary": "Parses --allow TAG arguments, runs lintian with --pedantic --display-info --fail-on none, then greps for errors/warnings not matching the allowlist pattern. Outputs annotated errors for GitHub Actions.",
      "tags": [
        "script",
        "lintian",
        "debian"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/lintian.sh"
    },
    {
      "id": "file:scripts/package/linux.sh",
      "type": "file",
      "name": "linux.sh",
      "summary": "Main Linux packaging script. Builds .deb (Debian/Ubuntu), .rpm (Fedora), and AppImage packages from release binaries. Each package installs oxiguitar (Wayland or X11), oxiguitar-cli, desktop entry, MIME type, icons, man pages, and documentation. The .deb and .rpm recommend/suggest plugins. The AppImage bundles both builds with required shared libraries.",
      "tags": [
        "script",
        "linux",
        "deb",
        "rpm",
        "appimage",
        "distribution"
      ],
      "complexity": "complex",
      "filePath": "scripts/package/linux.sh"
    },
    {
      "id": "function:scripts/package/linux.sh:stage",
      "type": "function",
      "name": "stage",
      "summary": "Installs binaries (oxiguitar, oxiguitar-cli), desktop entry, MIME type XML, metainfo, PNG icons (16-512px) plus scalable SVG, man pages (gzipped), and documentation (README, CHANGELOG, CREDITS, licenses, font licenses) into a staging tree under /usr prefix.",
      "tags": [
        "script",
        "packaging"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/linux.sh"
    },
    {
      "id": "function:scripts/package/linux.sh:deb_extras",
      "type": "function",
      "name": "deb_extras",
      "summary": "Generates the Debian changelog.gz (using SOURCE_DATE_EPOCH for reproducible builds) and DEBIAN/md5sums for a .deb package tree.",
      "tags": [
        "script",
        "debian"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/linux.sh"
    },
    {
      "id": "function:scripts/package/linux.sh:build_deb",
      "type": "function",
      "name": "build_deb",
      "summary": "Builds a .deb package: stages files, writes the Debian copyright file, generates changelog and md5sums, runs dpkg-shlibdeps to find linked libraries, writes the DEBIAN/control file with dependencies, recommends (guitarpro, midi, alsa, pipewire), and suggests (nam, eq, wah, musicxml, midi-file, tuxguitar). For X11 build, adds Provides/Conflicts/Replaces for oxiguitar. Finally runs dpkg-deb --build.",
      "tags": [
        "script",
        "debian",
        "packaging"
      ],
      "complexity": "complex",
      "filePath": "scripts/package/linux.sh"
    },
    {
      "id": "function:scripts/package/linux.sh:build_rpm",
      "type": "function",
      "name": "build_rpm",
      "summary": "Builds an .rpm package: stages files, installs LICENSE, generates a .spec file with requires (libwayland, libxkbcommon, libEGL, etc.), recommends (plugins), and suggests (optional plugins). Disables debug_package and build_id_links. Runs rpmbuild -bb and moves the result to dist/.",
      "tags": [
        "script",
        "rpm",
        "packaging"
      ],
      "complexity": "complex",
      "filePath": "scripts/package/linux.sh"
    },
    {
      "id": "function:scripts/package/linux.sh:build_appimage",
      "type": "function",
      "name": "build_appimage",
      "summary": "Builds a type 2 AppImage: stages files, installs the X11 binary as oxiguitar-x11, copies required shared libraries from target/appimage-libs/ into usr/lib/oxiguitar/libs, sets up the desktop entry and icon at the AppImage root, installs AppRun launcher, creates a squashfs image, and concatenates the AppImage runtime with the squashfs.",
      "tags": [
        "script",
        "appimage",
        "packaging"
      ],
      "complexity": "moderate",
      "filePath": "scripts/package/linux.sh"
    },
    {
      "id": "file:scripts/package/macos.sh",
      "type": "file",
      "name": "macos.sh",
      "summary": "Builds OxiGuitar.app and its disk image (.dmg) from a universal binary. Creates the app bundle with Info.plist (version substitution), PkgInfo, app and document icons (from PNGs via iconutil), licenses, and credits. Codesigns ad hoc (no developer certificate), then creates a HFS+ UDZO disk image with a link to Applications.",
      "tags": [
        "script",
        "macos",
        "distribution",
        "dmg"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/macos.sh"
    },
    {
      "id": "function:scripts/package/macos.sh:build",
