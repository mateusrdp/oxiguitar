      "id": "function:docs/manual/src/window.md:messages",
      "type": "function",
      "name": "Messages Footer",
      "summary": "One-line footer showing the latest error or warning. Click to see every message since OxiGuitar started; a chevron folds the list back. Stays quiet when everything works.",
