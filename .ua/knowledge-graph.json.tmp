    {
      "id": "file:scripts/package/version.sh",
      "type": "file",
      "name": "version.sh",
      "summary": "Prints the version for release packages. For v* tags (GITHUB_REF_TYPE=tag), extracts the workspace version from Cargo.toml's [workspace.package] and validates it matches the tag. For non-tag builds, appends ~dev.DATE.gCOMMIT suffix for proper version sorting (so the real release replaces dev builds).",
      "tags": [
        "script",
        "version",
        "CI"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/version.sh"
    },
