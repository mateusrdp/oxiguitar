      "id": "function:docs/manual/src/view.md:dark-page",
      "type": "function",
      "name": "Dark Page Mode",
      "summary": "Shows light notation on a dark page for easier night viewing. Only changes the screen: PDFs always print on a light page. The area around the page stays dark. Remembered across sessions.",
      "tags": [
        "docs",
        "manual",
        "dark-mode",
        "page-rendering"
      ],
      "complexity": "simple",
      "filePath": "docs/manual/src/view.md"
    },
