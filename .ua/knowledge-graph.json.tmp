      "id": "function:docs/manual/src/view.md:dark-interface",
      "type": "function",
      "name": "Dark Interface Toggle",
      "summary": "Switches the window's own colours between dark and light. Defaults to the desktop setting; once explicitly chosen, it stays. To reset, delete dark_interface from the view part of settings.json.",
      "tags": [
        "docs",
        "manual",
        "dark-mode",
        "theme"
      ],
      "complexity": "simple",
      "filePath": "docs/manual/src/view.md"
    },
