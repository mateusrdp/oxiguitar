    {
      "id": "file:scripts/package/check-glibc.sh",
      "type": "file",
      "name": "check-glibc.sh",
      "summary": "Checks ELF files (and plugin tar archives) for glibc version requirements, including weak references. Fails if any file needs a glibc newer than the given MAX (2.35 for Ubuntu 22.04). Used to verify AppImage binaries are compatible with the oldest supported Ubuntu.",
      "tags": [
        "script",
        "glibc",
        "compatibility",
        "ELF",
        "validation"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/check-glibc.sh"
    },
    {
      "id": "function:scripts/package/check-glibc.sh:check",
      "type": "function",
      "name": "check",
      "summary": "Iterates over files, unpacks plugin .tar archives to extract plugin.so, identifies ELF files, runs objdump -T to find the newest GLIBC version referenced (weak or strong), and compares against MAX using sort -V.",
      "tags": [
        "script",
        "glibc",
        "ELF"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/check-glibc.sh"
    },
    {
      "id": "file:scripts/package/in-wayland.sh",
      "type": "file",
      "name": "in-wayland.sh",
      "summary": "Runs a command as a Wayland client under a private, headless Weston compositor (software rendering via pixman). Used for testing the Wayland build where no desktop runs, analogous to xvfb-run for X11. Sets up XDG_RUNTIME_DIR and waits for the Wayland socket before executing the command.",
      "tags": [
        "script",
        "wayland",
        "testing",
        "weston"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/in-wayland.sh"
    },
    {
      "id": "function:scripts/package/in-wayland.sh:main",
      "type": "function",
      "name": "main",
      "summary": "Creates a private runtime directory, launches Weston with headless pixman renderer on a test socket, polls for the socket to appear, then runs the given command with DISPLAY unset and WAYLAND_DISPLAY set to the test socket.",
      "tags": [
        "script",
        "wayland",
        "testing"
      ],
      "complexity": "simple",
      "filePath": "scripts/package/in-wayland.sh"
    },
    {
      "id": "file:scripts/package/io.github.mateusrdp.OxiGuitar.yml",
      "type": "file",
