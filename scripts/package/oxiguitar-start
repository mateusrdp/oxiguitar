#
# The Flatpak's entry point (scripts/package/io.github.mateusrdp.OxiGuitar.yml),
# as the AppImage's AppRun (scripts/package/AppRun):
# the Flatpak holds both Linux builds, each with only its own display system's
# code (ADR 0009). With `--socket=wayland` and `--socket=fallback-x11`, Flatpak
# gives the sandbox Wayland in a Wayland session and X11 only where there is
# no Wayland, so: Wayland when it is there, else X11. With neither, the
# Wayland build starts and says what it is missing.

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${WAYLAND_SOCKET:-}" ] && [ -n "${DISPLAY:-}" ]; then
    exec /app/bin/oxiguitar-x11 "$@"
fi
exec /app/bin/oxiguitar "$@"
