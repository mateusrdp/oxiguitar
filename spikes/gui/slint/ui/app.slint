// GUI spike in Slint 1.18, revised after Mateus's review (16 Oct 2026):
// menus only along the top, a collapsible palette on the left, the score in
// the middle with its zoom slider in the corner, tracks along the bottom.
// See docs/design/ui.md for the rules behind it.

import { Button, LineEdit, Slider, ListView, Palette } from "std-widgets.slint";
import "../../../../assets/fonts/noto-sans/NotoSans-Regular.ttf";

export struct ToolItem {
    index: int,
    name: string,
    key: string,
    icon: image,
    on: bool,
}

export struct TrackItem {
    name: string,
    instrument: string,
    mute: bool,
    solo: bool,
    volume: float,
}

// A palette button: an icon drawn by our renderer and centred on its ink,
// tinted for the normal and selected states, with a tooltip.
component ToolButton inherits Rectangle {
    in property <ToolItem> tool;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: tool.on ? Palette.accent-background
        : touch.has-hover ? Palette.control-background.darker(0.15) : Palette.control-background;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Palette.accent-background.brighter(0.4) : Palette.border;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    Image {
        source: tool.icon;
        width: parent.width;
        height: parent.height;
        colorize: tool.on ? Palette.accent-foreground : Palette.control-foreground;
    }
    Tooltip {
        text: @markdown("\{tool.name} (\{tool.key})");
    }
}

// A palette group: a header that collapses and expands it, and buttons that
// wrap onto as many rows as the panel's width needs.
component ToolGroup inherits VerticalLayout {
    in property <string> title;
    in property <[ToolItem]> items;
    in-out property <bool> collapsed;
    callback clicked(int);
    spacing: 4px;
    alignment: start;

    if items.length > 0 : header := Rectangle {
        height: 20px;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.collapsed = !root.collapsed; }
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            // A small chevron: pointing down when open, right when collapsed.
            Rectangle {
                width: 10px;
                Path {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - 8px) / 2;
                    viewbox-width: 8;
                    viewbox-height: 8;
                    commands: root.collapsed ? "M 2 0 L 6 4 L 2 8" : "M 0 2 L 4 6 L 8 2";
                    stroke: Palette.foreground.transparentize(0.4);
                    stroke-width: 1.4px;
                }
            }
            Text {
                text: root.title;
                font-size: 11px;
                color: Palette.foreground.transparentize(0.3);
                vertical-alignment: center;
            }
        }
    }
    if !root.collapsed : FlexboxLayout {
        spacing: 4px;
        for item in items : ToolButton {
            tool: item;
            clicked => { root.clicked(self.tool.index); }
        }
    }
}

// A splitter bar: drag it to resize the panel next to it.
component Splitter inherits Rectangle {
    in property <bool> vertical;
    callback dragged(length);
    background: ta.has-hover || ta.pressed ? Palette.accent-background : Palette.border;
    ta := TouchArea {
        mouse-cursor: vertical ? col-resize : row-resize;
        moved => {
            if (self.pressed) {
                root.dragged(vertical ? self.mouse-x - self.pressed-x : self.mouse-y - self.pressed-y);
            }
        }
    }
}

// A small framed note that closes when clicked anywhere.
component InfoPopup inherits PopupWindow {
    in property <string> heading;
    in property <[string]> lines;
    width: 380px;
    Rectangle {
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Text { text: root.heading; font-size: 14px; font-weight: 700; }
            for line in root.lines : Text { text: line; font-size: 12px; wrap: word-wrap; }
        }
    }
}

export component AppWindow inherits Window {
    title: "OxiGuitar";
    preferred-width: 1280px;
    preferred-height: 800px;
    default-font-family: "Noto Sans";

    in property <[ToolItem]> values;
    in property <[ToolItem]> effects;
    in property <[ToolItem]> results;
    in-out property <[TrackItem]> tracks;
    in-out property <string> search;
    in-out property <length> palette-width: 168px;
    in-out property <length> tracks-height: 150px;
    in-out property <bool> show-palette: true;
    in-out property <bool> show-tracks: true;
    in-out property <bool> values-collapsed: false;
    // Bumped by Edit > Find Tool; the palette focuses its search field.
    in-out property <int> find-requests: 0;
    in-out property <bool> effects-collapsed: false;

    // Page style: 0 light, 1 dark, 2 parchment.
    in-out property <int> page-style: 0;
    in-out property <bool> page-light: true;
    in-out property <bool> page-dark: false;
    in-out property <bool> page-parchment: false;

    // Score zoom as log2 of the zoom factor: -2 is 25 %, 0 is 100 %, 2 is 400 %.
    in-out property <float> zoom-log: 0;
    in property <string> zoom-text: "100 %";
    in property <[string]> shortcut-lines;
    in property <[string]> about-lines;

    // The score canvas: the page's size, and the rendered visible part.
    in property <length> page-width;
    in property <length> page-height;
    in property <image> score;
    in property <length> score-x;
    in property <length> score-y;
    in property <length> score-width;
    in property <length> score-height;
    out property <length> view-x: -flick.content-x;
    out property <length> view-y: -flick.content-y;
    out property <length> view-width: flick.width;
    out property <length> view-height: flick.height;

    callback tool-clicked(int);
    callback shortcut(string) -> bool;
    callback zoom-moved(float);
    callback canvas-changed();
    callback search-edited(string);
    callback quit();

    function set-page(style: int) {
        root.page-style = style;
        root.page-light = style == 0;
        root.page-dark = style == 1;
        root.page-parchment = style == 2;
        root.canvas-changed();
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open…"; shortcut: @keys(Control + O); enabled: false; }
            MenuItem { title: "Save"; shortcut: @keys(Control + S); enabled: false; }
            MenuItem { title: "Save As…"; shortcut: @keys(Control + Shift + S); enabled: false; }
            MenuItem { title: "Export PDF…"; enabled: false; }
            MenuSeparator { }
            MenuItem { title: "Quit"; shortcut: @keys(Control + Q); activated => { root.quit(); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; shortcut: @keys(Control + Z); enabled: false; }
            MenuItem { title: "Redo"; shortcut: @keys(Control + Shift + Z); enabled: false; }
            MenuSeparator { }
            MenuItem { title: "Cut"; shortcut: @keys(Control + X); enabled: false; }
            MenuItem { title: "Copy"; shortcut: @keys(Control + C); enabled: false; }
            MenuItem { title: "Paste"; shortcut: @keys(Control + V); enabled: false; }
            MenuSeparator { }
            MenuItem {
                title: "Find Tool…";
                shortcut: @keys(Control + K);
                activated => {
                    root.show-palette = true;
                    root.find-requests += 1;
                }
            }
        }
        Menu {
            title: "View";
            Menu {
                title: "Page";
                MenuItem { title: "Light"; checkable: true; checked <=> root.page-light; activated => { root.set-page(0); } }
                MenuItem { title: "Dark"; checkable: true; checked <=> root.page-dark; activated => { root.set-page(1); } }
                MenuItem { title: "Parchment"; checkable: true; checked <=> root.page-parchment; activated => { root.set-page(2); } }
            }
            MenuItem { title: "Multitrack"; checkable: true; enabled: false; }
            MenuSeparator { }
            MenuItem { title: "Palette"; checkable: true; checked <=> root.show-palette; shortcut: @keys(F7); }
            MenuItem { title: "Tracks"; checkable: true; checked <=> root.show-tracks; shortcut: @keys(F8); }
        }
        Menu {
            title: "Help";
            MenuItem { title: "Keyboard and Mouse"; shortcut: @keys(F1); activated => { shortcuts-popup.show(); } }
            MenuItem { title: "About OxiGuitar"; activated => { about-popup.show(); } }
        }
    }

    shortcuts-popup := InfoPopup {
        x: (root.width - self.width) / 2;
        y: 60px;
        heading: "Keyboard and mouse";
        lines: root.shortcut-lines;
    }
    about-popup := InfoPopup {
        x: (root.width - self.width) / 2;
        y: 60px;
        heading: "OxiGuitar";
        lines: root.about-lines;
    }

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (!event.modifiers.control && !event.modifiers.alt && root.shortcut(event.text)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                // Palette.
                if root.show-palette : Rectangle {
                    width: root.palette-width;
                    background: Palette.alternate-background;
                    property <int> find: root.find-requests;
                    changed find => { search-edit.focus(); }
                    init => { if (root.find-requests > 0) { search-edit.focus(); } }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 10px;
                        alignment: start;
                        search-edit := LineEdit {
                            height: 28px;
                            min-width: 40px;
                            font-size: 12px;
                            placeholder-text: "Find tool";
                            text <=> root.search;
                            edited(t) => { root.search-edited(t); }
                            accepted => { keys.focus(); }
                        }
                        if root.search != "" : ToolGroup {
                            title: root.results.length > 0 ? "Results" : "No tool found";
                            items: root.results;
                            clicked(i) => { root.tool-clicked(i); }
                        }
                        if root.search == "" : ToolGroup {
                            title: "Note values";
                            collapsed <=> root.values-collapsed;
                            items: root.values;
                            clicked(i) => { root.tool-clicked(i); }
                        }
                        if root.search == "" : ToolGroup {
                            title: "Effects";
                            collapsed <=> root.effects-collapsed;
                            items: root.effects;
                            clicked(i) => { root.tool-clicked(i); }
                        }
                    }
                }

                if root.show-palette : Splitter {
                    vertical: true;
                    width: 4px;
                    dragged(d) => { root.palette-width = clamp(root.palette-width + d, 80px, 400px); }
                }

                // Score canvas: only the visible part of the page is rendered.
                canvas := Rectangle {
                    background: root.page-style == 1 ? #2a2b2e : root.page-style == 2 ? #d9cfb8 : #d8d8d8;
                    clip: true;
                    flick := Flickable {
                        content-width: root.page-width + 48px;
                        content-height: root.page-height + 48px;
                        changed content-x => { root.canvas-changed(); }
                        changed content-y => { root.canvas-changed(); }
                        changed width => { root.canvas-changed(); }
                        changed height => { root.canvas-changed(); }
                        Image {
                            x: root.score-x;
                            y: root.score-y;
                            width: root.score-width;
                            height: root.score-height;
                            source: root.score;
                            image-rendering: pixelated;
                        }
                    }

                    // Score zoom, bottom right: 25 % to 400 % on a logarithmic
                    // scale, so 100 % sits in the middle. Clicking the
                    // percentage resets it to 100 %.
                    Rectangle {
                        width: 168px;
                        height: 26px;
                        x: parent.width - self.width - 10px;
                        y: parent.height - self.height - 10px;
                        border-radius: 13px;
                        background: Palette.background.with-alpha(0.85);
                        border-color: Palette.border;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 4px;
                            Text {
                                text: root.zoom-text;
                                font-size: 11px;
                                width: 38px;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(0.2);
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.zoom-log = 0; root.zoom-moved(0); }
                                }
                            }
                            Slider {
                                minimum: -2;
                                maximum: 2;
                                step: 0.01;
                                value <=> root.zoom-log;
                                changed(v) => { root.zoom-moved(v); }
                            }
                        }
                    }
                }
            }

            if root.show-tracks : Splitter {
                vertical: false;
                height: 4px;
                dragged(d) => { root.tracks-height = clamp(root.tracks-height - d, 48px, 400px); }
            }

            // Track list.
            if root.show-tracks : Rectangle {
                height: root.tracks-height;
                background: Palette.alternate-background;
                ListView {
                    for track[i] in root.tracks : HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        height: 30px;
                        Text { text: i + 1; width: 16px; vertical-alignment: center; font-size: 12px; color: Palette.foreground.transparentize(0.4); }
                        LineEdit { text <=> track.name; width: 220px; font-size: 12px; }
                        Text { text: track.instrument; width: 130px; vertical-alignment: center; font-size: 12px; }
                        Button { text: "M"; width: 32px; checkable: true; checked <=> track.mute; }
                        Button { text: "S"; width: 32px; checkable: true; checked <=> track.solo; }
                        Slider { minimum: 0; maximum: 1; value <=> track.volume; width: 110px; }
                        Rectangle { }
                    }
                }
            }
        }
    }
}
