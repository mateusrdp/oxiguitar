<component type="desktop-application">
  <id>io.github.mateusrdp.OxiGuitar</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later AND GPL-3.0-only</project_license>
  <name>OxiGuitar</name>
  <summary>View, edit and play guitar tablature and scores</summary>
  <developer id="io.github.mateusrdp">
    <name>Mateus Rocha de Paula</name>
  </developer>
  <description>
    <p>
      OxiGuitar opens Guitar Pro files (.gp, .gpx, .gp5, .gp4 and .gp3) and
      shows them as standard notation and tablature, in four layouts, with
      any set of tracks together. It edits and saves them, exports them to
      PDF, and plays them, with a cursor on the beat being heard.
    </p>
    <ul>
      <li>Playback from the caret or a selection, with loop, count-in, metronome, speed from 25 to 200 % and a mixer for every track</li>
      <li>Your system's General MIDI sound set out of the box, and better sounds you add: SoundFont (SF2, SF3, DLS) and SFZ instruments with recorded guitars, basses and drums</li>
      <li>Note entry and editing with Guitar Pro 8's keys: effects, chords, lyrics, tracks, tunings and transposition</li>
      <li>Every file format, sound and audio output is a plugin, and anyone can write one</li>
    </ul>
    <p>
      No telemetry: OxiGuitar never uploads anything and downloads nothing.
    </p>
  </description>
  <launchable type="desktop-id">io.github.mateusrdp.OxiGuitar.desktop</launchable>
