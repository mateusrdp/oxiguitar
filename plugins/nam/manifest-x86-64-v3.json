{
  "interface": "1.4",
  "id": "oxiguitar.nam",
  "name": "NAM",
  "version": "0.11.0",
  "description": "Amp models (Neural Amp Modeler captures) and cabinet impulse responses on guitar and bass tracks, set in the track dialog. Models and impulse responses are files you put in the nam folder.",
  "authors": [
    "Mateus Rocha de Paula",
    "The OxiGuitar contributors"
  ],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mateusrdp/oxiguitar",
  "conditions": {
    "os": [
      "linux"
    ],
    "arch": [
      "x86_64"
    ],
    "cpu": [
      "sse3",
      "ssse3",
      "sse4.1",
      "sse4.2",
      "popcnt",
      "avx",
      "avx2",
      "bmi1",
      "bmi2",
      "f16c",
      "fma",
      "lzcnt",
      "movbe"
    ]
  },
  "effects": [
    {
      "id": "nam",
      "name": "NAM amp",
      "plays": [
        "fretted",
        "fretless"
      ]
    }
  ],
  "track_sections": [
    {
      "id": "nam",
      "title": "Amp (NAM)",
      "plays": [
        "fretted",
        "fretless"
      ]
    }
  ],
  "needs": [
    {
      "id": "oxiguitar.midi",
      "version": "0.11.0"
    }
  ],
  "folders": [
    "nam"
  ]
}
