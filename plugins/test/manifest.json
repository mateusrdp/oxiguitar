{
  "interface": "1.12",
  "id": "oxiguitar.test",
  "name": "Test plugin",
  "version": "0.21.3",
  "description": "Tests the plugin interface. Never shipped.",
  "authors": ["The OxiGuitar contributors"],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mateusrdp/oxiguitar",
  "requires": ["test-echo"],
  "formats": [
    {
      "id": "oxgtest",
      "name": "OxiGuitar test text",
      "extensions": ["oxgtest"],
      "read": true,
      "write": true,
      "signatures": [{ "at": 0, "text": "OXGTEST\n" }]
    }
  ],
  "instruments": [
    { "id": "drums", "name": "Test drums", "plays": ["drums"] },
    { "id": "no-drums", "name": "Test everything but drums", "does_not_play": ["drums"] }
  ],
  "effects": [
    { "id": "gain", "name": "Test gain (the section's level, half by default; silent under a stamped beat)", "follows_score": true, "order": 250 }
  ],
  "services": [
    { "interface": "test-echo", "id": "echo", "name": "Echo", "priority": 1 },
    { "interface": "test-echo", "id": "second", "name": "Second echo" },
    { "interface": "test-echo", "id": "unavailable", "name": "Never available", "priority": 9 },
    { "interface": "test-echo", "id": "elsewhere", "name": "Only on Plan 9", "priority": 20, "conditions": { "os": ["plan9"] } },
    { "interface": "audio-device", "id": "fake", "name": "Fake output (a test)", "priority": -100 }
  ],
  "tabs": [
    { "id": "panel", "title": "Test", "area": "bottom" },
    { "id": "side", "title": "Test side", "area": "right" },
    { "id": "ask", "title": "Test Dialog", "area": "dialog" },
    { "id": "settings", "title": "Test Settings", "area": "dialog" },
    { "id": "raw-options", "title": "Raw Test Audio", "area": "dialog" }
  ],
  "events": ["score", "selection", "playback"],
  "tools": [
    { "id": "mark", "name": "Mark the Title", "description": "Adds an exclamation mark to the score's title, as one change." },
    { "id": "link", "name": "Show a Footer Link", "description": "Shows a warning in the footer with a link to the plugin guide.", "palette": { "text": "Lnk" }, "menu": "Tools" },
    { "id": "stamp", "name": "Stamp the First Beat", "description": "Keeps the test plugin's data on the first beat with notes, which its gain then silences.", "palette": { "section": "Effects", "text": "T!" }, "menu": "Test", "shortcut": "Ctrl+Alt+J" },
    { "id": "ask", "name": "Open the Test Dialog", "description": "Opens the test plugin's dialog and shows its side tab.", "palette": { "section": "Test tools", "symbol": "U+E4A0" }, "menu": "Page", "toolbar": { "text": "Ask" } },
    { "id": "settings", "name": "Test Settings…", "description": "Opens the test plugin's settings, kept with OK and forgotten with Cancel.", "edits": false }
  ],
  "draws": true,
  "performs": true,
  "track_sections": [
    { "id": "test", "title": "Test section", "does_not_play": ["drums"] }
  ],
  "folders": ["soundfonts", "test-files"],
  "exporters": [
    { "id": "raw", "name": "Raw Test Audio", "extension": "oxgraw", "kind": "audio", "options": "raw-options" }
  ]
}
